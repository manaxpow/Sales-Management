
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-3">
        <h4 class="mb-0">Quản lý danh mục</h4>
        <div class="d-flex gap-2 flex-wrap">
            <input type="text" class="form-control form-control-sm" style="width: 250px;"
                   placeholder="Tìm kiếm tên danh mục..."
                   @bind="FilterText" @bind:event="oninput" />
            <button class="btn btn-success btn-sm" @onclick="OnAdd">
                Thêm danh mục
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 100px;">ID</th>
                    <th>Tên danh mục</th>
                    <th style="width: 130px;" class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Paginated.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">Không có danh mục nào</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Paginated)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" title="Sửa"
                                        @onclick="() => OnEdit.InvokeAsync(item)">
                                    Sửa
                                </button>
                                <button class="btn btn-sm btn-outline-danger" title="Xóa"
                                        @onclick="() => OnDelete.InvokeAsync(item)">
                                    Xóa
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
        <div>
            Hiển thị @(Paginated.Count()) trong tổng số @Filtered.Count() danh mục
        </div>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Page <= 0 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(Page - 1)">«</button>
                </li>
                @for (int i = 0; i < TotalPages; i++)
                {
                    int pageNum = i;
                    <li class="page-item @(i == Page ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageNum)">
                            @(i + 1)
                        </button>
                    </li>
                }
                <li class="page-item @(Page >= TotalPages - 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(Page + 1)">»</button>
                </li>
            </ul>
        </nav>
        <select class="form-select form-select-sm" style="width: auto;" 
                @onchange="ChangeRowsPerPage">
            <option value="5">5 / trang</option>
            <option value="10" selected>10 / trang</option>
            <option value="20">20 / trang</option>
            <option value="50">50 / trang</option>
        </select>
    </div>
</div>

@code {
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<CategoryDto> OnEdit { get; set; }
    [Parameter] public EventCallback<CategoryDto> OnDelete { get; set; }

    private string FilterText { get; set; } = string.Empty;
    private int PageRowsPerPage = 10;
    private int Page = 0;

    private IReadOnlyList<CategoryDto> Filtered => Categories
        .Where(c => c.Name.Contains(FilterText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IReadOnlyList<CategoryDto> Paginated => Filtered
        .Skip(Page * RowsPerPage)
        .Take(RowsPerPage)
        .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)RowsPerPage));

    private void ChangePage(int newPage)
    {
        if (newPage >= 0 && newPage < TotalPages)
            Page = newPage;
    }

    private void ChangeRowsPerPage(ChangeEventArgs e)
    {
        RowsPerPage = int.Parse(e.Value?.ToString() ?? "10");
        Page = 0;
        StateHasChanged();
    }

    public class CategoryDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}