
<div class="@(Open ? "modal fade show d-block" : "modal d-none")" 
     tabindex="-1" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xóa danh mục</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa danh mục <strong>@(Name ?? "này")</strong> không?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnClose">Hủy</button>
                <button type="button" class="btn btn-danger" @onclick="HandleDelete">Xóa</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task HandleDelete()
    {
        await OnConfirm.InvokeAsync();
        await OnClose.InvokeAsync();
    }
}