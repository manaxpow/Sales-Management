@page "/admin/category"
@using blazor_web.Models
@using blazor_web.DTOs.Category
@inject CategoryService CategoryService
@inject IJSRuntime JS

<h3 class="mb-4">Category Manager</h3>

@if (Loading)
{
    <div class="text-center mt-5">
        <div class="spinner-border"></div>
    </div>
}
else
{
    <CategoryTable Categories="categories"
                   OnEdit="OpenEdit"
                   OnDelete="OpenDelete"
                   OnAdd="OpenAdd" />

    <CategoryFormDialog 
        ModalId="categoryForm"
        Initial="editing"
        OnSave="Save"
        OnClose="OnFormClosed" />

    <CategoryDeleteDialog
        ModalId="categoryDelete"
        Name="deleting?.Name"
        OnConfirm="ConfirmDelete"
        OnClose="OnDeleteClosed" />

    @if (!string.IsNullOrEmpty(AlertMessage))
    {
        <div class="alert alert-@AlertType mt-3">@AlertMessage</div>
    }
}

@code {
    private List<Category> categories = new();
    private bool Loading = true;

    private Category? editing;
    private Category? deleting;

    private string AlertMessage = "";
    private string AlertType = "success";

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryService.GetAll();
        Loading = false;
    }

    async Task Save((CategoryRequest req, int? id) data)
    {
        if (data.id.HasValue)
        {
            var updated = await CategoryService.Update(data.id.Value, data.req);
            if (updated != null)
            {
                var idx = categories.FindIndex(x => x.Id == updated.Id);
                categories[idx] = updated;
                Success("Cập nhật thành công");
            }
            else Error("Không cập nhật được");
        }
        else
        {
            var created = await CategoryService.Create(data.req);
            if (created != null)
            {
                categories.Add(created);
                Success("Tạo danh mục thành công");
            }
            else Error("Không tạo được danh mục");
        }
    }

    void Success(string msg) { AlertMessage = msg; AlertType = "success"; }
    void Error(string msg) { AlertMessage = msg; AlertType = "danger"; }

    void OpenAdd()
    {
        editing = null;
        JS.InvokeVoidAsync("bootstrapShow", "#categoryForm");
    }

    void OpenEdit(Category c)
    {
        editing = c;
        JS.InvokeVoidAsync("bootstrapShow", "#categoryForm");
    }

    void OpenDelete(Category c)
    {
        deleting = c;
        JS.InvokeVoidAsync("bootstrapShow", "#categoryDelete");
    }

    Task OnFormClosed() { editing = null; return Task.CompletedTask; }
    Task OnDeleteClosed() { deleting = null; return Task.CompletedTask; }

    async Task ConfirmDelete()
    {
        if (deleting == null) return;
        var ok = await CategoryService.Delete(deleting.Id);
        if (ok)
        {
            categories.RemoveAll(c => c.Id == deleting.Id);
            Success("Xoá thành công");
        }
        else Error("Không xoá được");

        deleting = null;
    }
}
