@using blazor_web.DTOs.Supplier
@using blazor_web.Services.Category
@using blazor_web.Models

<div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        Filter Products
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Product Name -->
        <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700">Product Name</label>
            <input type="text" placeholder="Search products..." @bind="@CurrentFilter.ProductName"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>

        <!-- Category Filter -->
        <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700">Category</label>
            <select @bind="@CurrentFilter.CategoryId"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <option value="">All Categories</option>
                @foreach (var c in Categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>

        <!-- Supplier Filter -->
        <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700">Supplier</label>
            <select @bind="@CurrentFilter.SupplierId"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">All Suppliers</option>
                @foreach (var s in Suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>

        <!-- Max Price -->
        <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700">Max Price</label>
            <input @bind="@CurrentFilter.Price" type="number" placeholder="Enter max price" min="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex justify-between items-center mt-6">
        <div class="text-sm text-gray-600">
            Showing <span class="font-semibold text-blue-600">@TotalProducts</span> products
        </div>

        <div class="flex space-x-3">
            <button class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg" @onclick="ResetFilters">
                Reset
            </button>

            <button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow-md"
                @onclick="ApplyFilters">
                Apply Filters
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<ProductFilter> OnFilterChanged { get; set; }

    [Parameter] public ProductFilter CurrentFilter { get; set; } = new();

    [Parameter] public List<CategoryResponse> Categories { get; set; } = new();
    [Parameter] public List<SupplierResponse> Suppliers { get; set; } = new();

    [Parameter] public int TotalProducts { get; set; } = 0;


    private async Task ApplyFilters()
    {
        await OnFilterChanged.InvokeAsync(CurrentFilter);
    }

    private async Task ResetFilters()
    {
        CurrentFilter = new ProductFilter();


        await OnFilterChanged.InvokeAsync(CurrentFilter);
    }

    protected override void OnParametersSet()
    {
        // Force re-render computed values when parent updates parameters
        StateHasChanged();
    }
}