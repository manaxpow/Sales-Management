@page "/products"

@inject IProductService productService
@inject CategoryService categoryService
@inject IJSRuntime JS
@using blazor_web.Components.UI
@using blazor_web.DTOs.Supplier
@using blazor_web.Models
@using blazor_web.Services.Cart
@using blazor_web.Services.Category
@using blazor_web.Services.Supplier
@rendermode InteractiveServer
@inject ICartService CartService
@inject ISupplierService supplierService


<PageTitle>Products</PageTitle>

<!-- Page Header -->
<div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-8 px-4 rounded-lg mb-8 shadow-xl">
    <div class="max-w-7xl mx-auto">
        <div class="mb-4">
            @if (showAddToCartMessage && !string.IsNullOrEmpty(addToCartMessage))
            {
                <div class="p-3 rounded-lg bg-green-50 border border-green-200 text-sm text-green-700">
                    @addToCartMessage
                </div>
            }
        </div>

        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold mb-2">Product Catalog</h1>
                <p class="text-blue-100">Discover our amazing collection of products</p>
            </div>
            <div class="flex items-center space-x-2">
                <svg class="w-8 h-8 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span class="text-xl font-semibold">@dataRes.TotalProduct Products</span>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto">
    <!-- Filter Component -->
    <Filter OnFilterChanged="HandleFilterChanged" Categories="categories" Suppliers="suppliers"
        TotalProducts="dataRes.TotalProduct" CurrentFilter="productFilter" />

    <!-- Sort and View Options -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-6">
        <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
            <div class="flex items-center space-x-4">
                <span class="text-sm font-medium text-gray-700">Sort by:</span>
                <select @onchange="OnSortChange"
                    class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                    <option value="name-asc">Name (A-Z)</option>
                    <option value="name-desc">Name (Z-A)</option>
                    <option value="price-asc">Price (Low to High)</option>
                    <option value="price-desc">Price (High to Low)</option>
                    <option value="createdat-asc">Newest First</option>
                    <option value="createdat-desc">Oldest First</option>
                </select>
            </div>

            <div class="flex items-center space-x-2">
                <button class="p-2 text-gray-500 hover:text-blue-600 transition-colors duration-200" title="Grid View">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                    </svg>
                </button>
                <button class="p-2 text-gray-500 hover:text-blue-600 transition-colors duration-200" title="List View">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="mb-8">
        @if (products.Count > 0)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var product in products)
                {
                    <blazor_web.Components.UI.Card.ProductCard Product="@product"
                        OnAddToCartClick="@((ProductResponse p) => HandleAddToCart(p))" />
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg shadow-md p-12 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No products found</h3>
                <p class="text-gray-500">Try adjusting your filters or search criteria</p>
            </div>
        }
    </div>

    <!-- Pagination Component -->
    <blazor_web.Components.UI.Pagination CurrentPage="@CurrentPage" TotalPages="@dataRes.TotalPage"
        TotalItems="@dataRes.TotalProduct" ItemsPerPage="limit" OnPageChanged="HandlePageChanged"
        OnItemsPerPageChanged="HandleItemsPerPageChanged" />
    <SnackBoard @ref="snackBoard" />
</div>

@code {
    private List<CategoryResponse> categories = new();
    private List<SupplierResponse> suppliers = new();
    private List<ProductResponse> products = new();
    private ProductFilter productFilter = new();
    private GetProductResponse dataRes = new();
    public int CurrentPage = 1;
    private int limit = 8;

    private string addToCartMessage = "";
    private bool showAddToCartMessage = false;
    private SnackBoard snackBoard = new SnackBoard();


    protected override async Task OnInitializedAsync()
    {
        ApiResponse<List<CategoryResponse>>? cateRes = await categoryService.GetAll();
        var supplierResponses = await supplierService.GetSuppliersAsync();
        if (cateRes != null)
        {
            categories = cateRes.Data;
        }
        if (supplierResponses != null)
        {
            suppliers = supplierResponses.Data;
        }
        await LoadData();
    }
    private async Task LoadData()
    {

        productFilter.Page = CurrentPage;
        productFilter.Limit = limit;
        var response = await productService.GetAllProduct(productFilter);

        products = response.Data.Products ?? new();
        dataRes = response.Data;
        Console.WriteLine($"[Products] LoadData: Page={CurrentPage}, Limit={limit}, TotalProducts={dataRes.TotalProduct}");
        StateHasChanged();
    }

    private async Task HandleFilterChanged(ProductFilter newFilter)
    {
        CurrentPage = 1;
        productFilter = newFilter;
        await LoadData();
    }

    private async Task OnLimitChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newLimit))
        {
            limit = newLimit;
        }
        else limit = 8;
        Console.WriteLine($"[Products] OnLimitChange: {limit}");
        CurrentPage = 1;
        await LoadData();
    }
    private async Task HandlePageChanged(int newPage)
    {

        CurrentPage = newPage;
        await JS.InvokeVoidAsync("scrollTo", new object[] { 0, 0 });
        await LoadData();
    }

    private async Task HandleItemsPerPageChanged(int newLimit)
    {
        limit = newLimit;
        CurrentPage = 1;
        await JS.InvokeVoidAsync("scrollTo", new object[] { 0, 0 });
        await LoadData();
    }

    private async Task Search()
    {
        CurrentPage = 1;
        await LoadData();
    }

    private string FormatPrice(decimal price)
    {
        return price.ToString("N0") + " ₫";
    }



    private async Task HandleAddToCart(ProductResponse data)
    {
        var product = ProductMapper.ToModel(data);
        Console.WriteLine($"[Products] HandleAddToCart: {product.ProductId} - {product.ProductName}");
        await CartService.AddItemAsync(product, 1);
        snackBoard.Show($"{product.ProductName} has been added to your cart!", "success", "top-right");
    }

    private async Task OnSortChange(ChangeEventArgs e)
    {
        var sortValue = e.Value?.ToString();
        if (!string.IsNullOrEmpty(sortValue))
        {
            var parts = sortValue.Split('-');
            if (parts.Length == 2)
            {
                productFilter.SortBy = parts[0];
                productFilter.SortOrder = parts[1];
                CurrentPage = 1;
                await LoadData();
            }
        }
    }
}