@page "/products"

@rendermode InteractiveServer

@using blazor_web.Models
@using blazor_web.Services.Cart

@inject ICartService CartService

<PageTitle>Products</PageTitle>

<!-- Page Header -->
<div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-8 px-4 rounded-lg mb-8 shadow-xl">
    <div class="max-w-7xl mx-auto">
        <div class="mb-4">
            @if (showAddToCartMessage && !string.IsNullOrEmpty(addToCartMessage))
            {
                <div class="p-3 rounded-lg bg-green-50 border border-green-200 text-sm text-green-700">
                    @addToCartMessage
                </div>
            }
        </div>

        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold mb-2">Product Catalog</h1>
                <p class="text-blue-100">Discover our amazing collection of products</p>
            </div>
            <div class="flex items-center space-x-2">
                <svg class="w-8 h-8 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span class="text-xl font-semibold">@totalProducts Products</span>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto">
    <!-- Filter Component -->
    <Filter OnFilterChanged="HandleFilterChanged" />

    <!-- Sort and View Options -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-6">
        <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
            <div class="flex items-center space-x-4">
                <span class="text-sm font-medium text-gray-700">Sort by:</span>
                <select class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                    <option value="name">Name (A-Z)</option>
                    <option value="name-desc">Name (Z-A)</option>
                    <option value="price-low">Price (Low to High)</option>
                    <option value="price-high">Price (High to Low)</option>
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                </select>
            </div>
            
            <div class="flex items-center space-x-2">
                <button class="p-2 text-gray-500 hover:text-blue-600 transition-colors duration-200" title="Grid View">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                    </svg>
                </button>
                <button class="p-2 text-gray-500 hover:text-blue-600 transition-colors duration-200" title="List View">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="mb-8">
        @if (paginatedProducts.Count > 0)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var product in paginatedProducts)
                {
                    <blazor_web.Components.UI.Card.ProductCard Product="@product" OnAddToCartClick="@( (blazor_web.Models.Product p) => HandleAddToCart(p) )" />
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg shadow-md p-12 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No products found</h3>
                <p class="text-gray-500">Try adjusting your filters or search criteria</p>
            </div>
        }
    </div>

    <!-- Pagination Component -->
    <blazor_web.Components.UI.Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                TotalItems="totalProducts"
                ItemsPerPage="itemsPerPage"
                OnPageChanged="HandlePageChanged"
                OnItemsPerPageChanged="HandleItemsPerPageChanged" />
</div>

@code {
    // Pagination state
    private int currentPage = 1;
    private int itemsPerPage = 8;
    private int totalPages = 1;
    private int totalProducts = 0;

    // Filter state
    private string searchTerm = "";
    private int? categoryId = null;
    private int? supplierId = null;
    private decimal? maxPrice = null;

    private string? addToCartMessage;
    private bool showAddToCartMessage;

    // Fake product data
    private List<blazor_web.Models.Product> allProducts = new();
    private List<blazor_web.Models.Product> filteredProducts = new();
    private List<blazor_web.Models.Product> paginatedProducts = new();

    protected override void OnInitialized()
    {
        GenerateFakeProducts();
        ApplyFiltersAndPagination();
    }

    private void GenerateFakeProducts()
    {
        var random = new Random();
        var productNames = new[]
        {
            "Laptop Pro 15", "Wireless Mouse", "USB-C Hub", "Mechanical Keyboard", "4K Monitor",
            "Webcam HD", "Desk Lamp LED", "Office Chair", "Standing Desk", "Cable Organizer",
            "Phone Stand", "Tablet Case", "Power Bank", "Bluetooth Speaker", "Smart Watch",
            "Fitness Tracker", "Yoga Mat", "Water Bottle", "Gym Bag", "Running Shoes",
            "Coffee Maker", "Electric Kettle", "Toaster Oven", "Blender", "Air Fryer",
            "Vacuum Cleaner", "Washing Machine", "Refrigerator", "Microwave Oven", "Dishwasher"
        };

        var barcodes = new[]
        {
            "1234567890123", "2345678901234", "3456789012345", "4567890123456", "5678901234567",
            "6789012345678", "7890123456789", "8901234567890", "9012345678901", "0123456789012"
        };

        allProducts = productNames.Select((name, index) => new blazor_web.Models.Product
        {
            ProductId = index + 1,
            ProductName = name,
            CategoryId = random.Next(1, 6),
            SupplierId = random.Next(1, 6),
            Barcode = barcodes[random.Next(barcodes.Length)],
            Price = (decimal)Math.Round(random.Next(10, 1000) + random.NextDouble(), 2),
            Unit = random.Next(0, 2) == 0 ? "pcs" : "set",
            CreatedAt = DateTime.Now.AddDays(-random.Next(1, 365))
        }).ToList();

        totalProducts = allProducts.Count;
        filteredProducts = new List<blazor_web.Models.Product>(allProducts);
    }

    private void ApplyFiltersAndPagination()
    {
        // Apply filters (simplified for demo)
        filteredProducts = allProducts.Where(p =>
            (string.IsNullOrEmpty(searchTerm) || p.ProductName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (!categoryId.HasValue || p.CategoryId == categoryId.Value) &&
            (!supplierId.HasValue || p.SupplierId == supplierId.Value) &&
            (!maxPrice.HasValue || p.Price <= maxPrice.Value)
        ).ToList();

        // Update totals
        totalProducts = filteredProducts.Count;
        totalPages = (int)Math.Ceiling((double)totalProducts / itemsPerPage);

        // Ensure current page is valid
        currentPage = Math.Min(currentPage, Math.Max(1, totalPages));

        // Get paginated results
        paginatedProducts = filteredProducts
            .Skip((currentPage - 1) * itemsPerPage)
            .Take(itemsPerPage)
            .ToList();
    }

    private void HandleFilterChanged()
    {
        currentPage = 1; // Reset to first page when filters change
        ApplyFiltersAndPagination();
        StateHasChanged();
    }

    private void HandlePageChanged(int page)
    {
        currentPage = page;
        ApplyFiltersAndPagination();
        StateHasChanged();
    }

    private void HandleItemsPerPageChanged(int pageSize)
    {
        itemsPerPage = pageSize;
        currentPage = 1; // Reset to first page
        ApplyFiltersAndPagination();
        StateHasChanged();
    }

    private async Task HandleAddToCart(blazor_web.Models.Product product)
    {
        Console.WriteLine($"[Products] HandleAddToCart: {product.ProductId} - {product.ProductName}");
        await CartService.AddItemAsync(product, 1);

        addToCartMessage = $"Đã thêm \"{product.ProductName}\" vào giỏ hàng.";
        showAddToCartMessage = true;
    }

}
