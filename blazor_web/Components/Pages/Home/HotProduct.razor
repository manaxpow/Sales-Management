@*
    Hot Products Component - Display featured products using ProductCard
*@

@using System.Threading.Tasks
@using blazor_web.Components.UI
@using blazor_web.Components.UI.Card
@using blazor_web.Models
@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json

@inject HttpClient Http
@inject blazor_web.Services.Cart.ICartService CartService
@inject Blazored.Toast.Services.IToastService Toast
@inject NavigationManager Navigation

<div class="py-12">
    <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">
            🔥 Hot Products
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Discover our most popular products that customers love. Limited stock available!
        </p>
    </div>

    @if (_isLoading) {
        <div class="text-center py-8">
            <div class="inline-block animate-pulse text-gray-500">Loading hot products...</div>
        </div>
    } else if (!string.IsNullOrEmpty(_errorMessage)) {
        <div class="text-center py-8 text-red-600">
            @_errorMessage
        </div>
    } else {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
            @foreach (var p in HotProducts) {
                <ProductCard Product="@p" OnAddToCartClick="HandleAddToCart" />
            }
        </div>

        <div class="text-center mt-12">
            <a href="/products"
               class="no-underline inline-block bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg">
                View All Products
            </a>
        </div>
    }
</div>

@code {
    private List<ProductResponse> HotProducts { get; set; } = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    [Parameter]
    public int Limit { get; set; } = 8;

    protected override async Task OnInitializedAsync() {
        await LoadHotProductsAsync();
    }

    private async Task LoadHotProductsAsync() {
        _isLoading = true;
        _errorMessage = null;

        try {
            var apiResp = await Http.GetFromJsonAsync<ApiResponse<GetProductResponse>>("products");

            if (apiResp?.Success != true || apiResp.Data?.Products == null) {
                _errorMessage = apiResp?.Message ?? "Lỗi tải dữ liệu.";
                return;
            }

            HotProducts = apiResp.Data.Products
                .OrderByDescending(p => p.Quantity)
                .ThenByDescending(p => p.ProductId)
                .Take(Limit)
                .ToList();
        } catch (Exception ex) {
            Console.WriteLine($"[HotProducts] Load error: {ex}");
            _errorMessage = "Có lỗi khi tải sản phẩm. Thử lại sau.";
        } finally {
            _isLoading = false;
            StateHasChanged();
        }
    }
    private async Task HandleAddToCart(ProductResponse data)
    {
        var product = ProductMapper.ToModel(data);
        Console.WriteLine($"[Products] HandleAddToCart: {product.ProductId} - {product.ProductName}");
        await CartService.AddItemAsync(product, 1);
        snackBoard.Show($"{product.ProductName} has been added to your cart!", "success");

    }

    private async Task LoadData()
    {
        var response = await productService.GetAllProduct(new ProductFilter
        {
            Page = 1,
            Limit = 8
        });
        Console.WriteLine($"[HotProduct] LoadData: Retrieved {response.Data?.Products?.Count ?? 0} products");
    }
    private Product MapToModelProduct(ProductResponse r) {
        return new Product {
            ProductId = r.ProductId,
            ProductName = r.ProductName ?? string.Empty,
            Barcode = r.Barcode ?? string.Empty,
            CategoryId = r.CategoryId,
            SupplierId = r.SupplierId,
            Price = r.Price,
            Unit = r.Unit ?? "pcs",
            CreatedAt = DateTime.Now
        };
    }

    private async Task HandleAddToCart(Product product) {
        try {
            // Convert ProductResponse → Product model for Cart
            var product = new Product {
                ProductId = r.ProductId,
                ProductName = r.ProductName,
                Barcode = r.Barcode,
                CategoryId = r.CategoryId,
                SupplierId = r.SupplierId,
                Price = r.Price,
                Unit = r.Unit,
                CreatedAt = DateTime.Now
            };

            var success = await CartService.AddItemAsync(product, 1);

            if (success)
                Toast.ShowSuccess($"Đã thêm “{r.ProductName}” vào giỏ hàng!");
            else
                Toast.ShowWarning("Không thể thêm vào giỏ hàng.");
        } catch (Exception ex) {
            Console.WriteLine(ex);
            Toast.ShowError("Lỗi khi thêm vào giỏ!");
        }
    }
}
