@*
        Hot Products Component - Display featured products using ProductCard
    *@

@using System.Threading.Tasks
@using blazor_web.Components.UI.Card
@inject IProductService productService
<div class="py-12">
    <!-- Section Header -->
    <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">
            🔥 Hot Products
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Discover our most popular products that customers love. Limited stock available!
        </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        @foreach (var product in HotProducts)
        {
            <ProductCard Product="@product" OnAddToCartClick="@(() => HandleAddToCart(ProductMapper.ToModel(product)))" />
        }
    </div>

    <!-- View All Products Button -->
    <div class="text-center mt-12">
        <a href="/products"
            class="no-underline inline-block bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg">
            View All Products
        </a>
    </div>
</div>

@code {
    public List<ProductResponse> HotProducts { get; set; } = new();

    public GetProductResponse ProductData { get; set; } = new();
    private bool _loaded = false;
    protected override async Task OnInitializedAsync()
    {
        if (!_loaded)
        {
            _loaded = true;
            await LoadData();
        }
        // For demo purposes, we will just take the first 8 products as hot products
    }
    private void HandleAddToCart(blazor_web.Models.Product product)
    {
        Console.WriteLine($"Add to cart product: {product.ProductName}");
    }
    private async Task LoadData()
    {
        var response = await productService.GetAllProduct(new ProductFilter
        {
            Page = 1,
            Limit = 8
        });
        Console.WriteLine($"[HotProduct] LoadData: Retrieved {response.Data?.Products?.Count ?? 0} products");

        HotProducts = response.Data?.Products ?? new List<ProductResponse>();
    }
}