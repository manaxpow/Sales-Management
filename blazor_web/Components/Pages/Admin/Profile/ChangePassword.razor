@page "/admin/profile/change-password"
@rendermode InteractiveServer

@using blazor_web.DTOs.Auth
@using blazor_web.Services.Auth
@using blazor_web.Services.Storage
@using Microsoft.AspNetCore.Components
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorageService

<PageTitle>Đổi Mật Khẩu - Quản Trị Viên</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-key me-2"></i>
                        Đổi Mật Khẩu
                    </h4>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Đang xử lý...</span>
                            </div>
                            <p class="mt-2">Đang tải thông tin...</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@changePasswordRequest" OnValidSubmit="@HandleChangePassword">
                            <DataAnnotationsValidator />
                            
                            <div class="mb-3">
                                <label for="currentPassword" class="form-label">
                                    <i class="fas fa-lock me-1"></i>
                                    Mật khẩu hiện tại
                                </label>
                                <InputText type="password" id="currentPassword" class="form-control" @bind-Value="changePasswordRequest.Password" placeholder="Nhập mật khẩu hiện tại" />
                                <ValidationMessage For="@(() => changePasswordRequest.Password)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">
                                    <i class="fas fa-lock me-1"></i>
                                    Mật khẩu mới
                                </label>
                                <InputText type="password" id="newPassword" class="form-control" @bind-Value="changePasswordRequest.NewPassword" placeholder="Nhập mật khẩu mới" />
                                <ValidationMessage For="@(() => changePasswordRequest.NewPassword)" class="text-danger" />
                                <div class="form-text">Mật khẩu phải có ít nhất 6 ký tự</div>
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">
                                    <i class="fas fa-lock me-1"></i>
                                    Xác nhận mật khẩu mới
                                </label>
                                <InputText type="password" id="confirmPassword" class="form-control" @bind-Value="confirmPassword" placeholder="Nhập lại mật khẩu mới" />
                                @if (!string.IsNullOrEmpty(confirmPassword) && confirmPassword != changePasswordRequest.NewPassword)
                                {
                                    <div class="text-danger small mt-1">
                                        <i class="fas fa-exclamation-circle me-1"></i>
                                        Mật khẩu xác nhận không khớp
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    @errorMessage
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <div class="alert alert-success" role="alert">
                                    <i class="fas fa-check-circle me-2"></i>
                                    @successMessage
                                </div>
                            }

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Đang xử lý...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-key me-2"></i>
                                        <span>Đổi Mật Khẩu</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="GoBackToProfile">
                                    <i class="fas fa-arrow-left me-2"></i>
                                    Quay Lại Hồ Sơ
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
            
            <!-- Security Tips -->
            <div class="card mt-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="fas fa-shield-alt me-2"></i>
                        Mẹo Bảo Mật
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0 small">
                        <li>Sử dụng mật khẩu mạnh có ít nhất 8 ký tự</li>
                        <li>Kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt</li>
                        <li>Không sử dụng thông tin cá nhân dễ đoán</li>
                        <li>Thay đổi mật khẩu định kỳ 3 tháng/lần</li>
                        <li>Không chia sẻ mật khẩu với người khác</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ChangePasswordRequest changePasswordRequest = new();
    private string confirmPassword = string.Empty;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private int currentUserId = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserInfo();
        }
    }

    private async Task LoadUserInfo()
    {
        try
        {
            var loginInfo = await LocalStorageService.GetLoginInfoAsync();
            if (loginInfo?.User != null)
            {
                currentUserId = loginInfo.User.Id;
                changePasswordRequest.UserId = currentUserId;
            }
            else
            {
                errorMessage = "Không tìm thấy thông tin quản trị viên. Vui lòng đăng nhập lại.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải thông tin quản trị viên: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleChangePassword()
    {
        if (string.IsNullOrEmpty(confirmPassword))
        {
            errorMessage = "Vui lòng xác nhận mật khẩu mới.";
            return;
        }

        if (confirmPassword != changePasswordRequest.NewPassword)
        {
            errorMessage = "Mật khẩu xác nhận không khớp với mật khẩu mới.";
            return;
        }

        if (string.IsNullOrEmpty(changePasswordRequest.Password))
        {
            errorMessage = "Vui lòng nhập mật khẩu hiện tại.";
            return;
        }

        if (string.IsNullOrEmpty(changePasswordRequest.NewPassword))
        {
            errorMessage = "Vui lòng nhập mật khẩu mới.";
            return;
        }

        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var response = await AuthService.ChangePasswordAsync(changePasswordRequest);

            if (response.Success)
            {
                successMessage = response.Message ?? "Đổi mật khẩu thành công!";
                
                // Clear form after successful password change
                changePasswordRequest.Password = string.Empty;
                changePasswordRequest.NewPassword = string.Empty;
                confirmPassword = string.Empty;

                // Redirect to profile page after 2 seconds
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/admin/profile");
            }
            else
            {
                errorMessage = response.Message ?? "Đổi mật khẩu thất bại.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Có lỗi xảy ra: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void GoBackToProfile()
    {
        NavigationManager.NavigateTo("/admin/profile");
    }
}