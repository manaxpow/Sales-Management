@page "/admin/suppliers/edit/{SupplierId:int}"
<ProtectedRoute RequiredRoles="admin"/>

@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using blazor_web.DTOs.Supplier
@using blazor_web.Services.Supplier
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject ISupplierService SupplierService
@inject NavigationManager Navigation

<div class="p-6 bg-gray-50 min-h-screen">
    @* Header *@
    <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl font-bold text-gray-800">Cập nhật Nhà cung cấp</h3>
        <a href="/admin/suppliers" class="text-gray-600 hover:text-gray-800 flex items-center gap-1 text-xl font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Quay lại danh sách
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-10">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-gray-500">Đang tải thông tin...</p>
        </div>
    }
    else if (SupplierData?.Id > 0)
    {
        @* Form Container *@
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="mb-6 pb-4 border-b border-gray-100">
                <h4 class="text-lg font-medium text-gray-700">Thông tin: <span class="text-blue-600 font-bold">@SupplierData.Name</span></h4>
            </div>

            <EditForm Model="@formData" OnValidSubmit="HandleSubmit" FormName="updateSupplierForm">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @* Tên nhà cung cấp *@
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="name">
                            Tên nhà cung cấp <span class="text-red-500">*</span>
                        </label>
                        <InputText id="name" @bind-Value="formData.Name" class="@GetInputClass("Name")" />
                        <ValidationMessage For="() => formData.Name" class="text-red-500 text-xs mt-1" />
                        @if (errors.TryGetValue("name", out var nameError) && !string.IsNullOrEmpty(nameError))
                        {
                            <p class="text-red-500 text-xs mt-1">@nameError</p>
                        }
                    </div>

                    @* Số điện thoại *@
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="phone">
                            Số điện thoại <span class="text-red-500">*</span>
                        </label>
                        <InputText id="phone" @bind-Value="formData.Phone" class="@GetInputClass("Phone")" />
                        <ValidationMessage For="() => formData.Phone" class="text-red-500 text-xs mt-1" />
                        @if (errors.TryGetValue("phone", out var phoneError) && !string.IsNullOrEmpty(phoneError))
                        {
                            <p class="text-red-500 text-xs mt-1">@phoneError</p>
                        }
                    </div>

                    @* Email *@
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="email">
                            Email <span class="text-red-500">*</span>
                        </label>
                        <InputText id="email" @bind-Value="formData.Email" class="@GetInputClass("Email")" />
                        <ValidationMessage For="() => formData.Email" class="text-red-500 text-xs mt-1" />
                        @if (errors.TryGetValue("email", out var emailError) && !string.IsNullOrEmpty(emailError))
                        {
                            <p class="text-red-500 text-xs mt-1">@emailError</p>
                        }
                    </div>

                    @* Địa chỉ *@
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="address">
                            Địa chỉ <span class="text-red-500">*</span>
                        </label>
                        <InputText id="address" @bind-Value="formData.Address" class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                        <ValidationMessage For="() => formData.Address" class="text-red-500 text-xs mt-1" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(apiError))
                {
                    <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded text-red-700 text-sm">
                        @apiError
                    </div>
                }

                <div class="mt-8 flex items-center gap-3">
                    <button
                        type="submit"
                        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition font-medium flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled="@isSubmitting"
                    >
                        @if (isSubmitting)
                        {
                            <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <span>Lưu thay đổi</span>
                        }
                    </button>
                    
                    <button
                        type="button"
                        @onclick='() => Navigation.NavigateTo("/admin/suppliers")'
                        class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition font-medium"
                        disabled="@isSubmitting"
                    >
                        Hủy bỏ
                    </button>
                </div>
            </EditForm>
        </div>
    }
    else
    {
        <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Không tìm thấy nhà cung cấp với ID: <span class="font-bold">@SupplierId</span>.
        </div>
    }
</div>

@code {
    [Parameter]
    public int SupplierId { get; set; }

    private SupplierResponse? SupplierData;
    private UpdateSupplierRequest formData = new UpdateSupplierRequest();
    private Dictionary<string, string> errors = new Dictionary<string, string>();
    private string? apiError;
    private bool isSubmitting = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSupplierData();
    }
    
    private async Task LoadSupplierData()
    {
        isLoading = true;
        
        var response = await SupplierService.GetSupplierByIdAsync(SupplierId);
        
        if (response.Success && response.Data != null)
        {
            SupplierData = response.Data;
            formData.Id = SupplierData.Id;
            formData.Name = SupplierData.Name;
            formData.Phone = SupplierData.Phone;
            formData.Email = SupplierData.Email;
            formData.Address = SupplierData.Address;
        }
        else
        {
            SupplierData = null;
        }
        
        isLoading = false;
    }


    private string GetInputClass(string fieldName)
    {
        string baseClass = "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors";
        bool hasError = errors.ContainsKey(fieldName.ToLower()) && !string.IsNullOrEmpty(errors[fieldName.ToLower()]);
        
        if (hasError)
        {
             return $"{baseClass} border-red-500 bg-red-50 text-red-900 placeholder-red-300 focus:ring-red-500 focus:border-red-500";
        }
        return $"{baseClass} border-gray-300";
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting || SupplierId <= 0) return;

        isSubmitting = true;
        errors.Clear();
        apiError = null;

        var result = await SupplierService.UpdateSupplierAsync(SupplierId, formData);

        if (result.Success)
        {
            Navigation.NavigateTo("/admin/suppliers"); 
        }
        else
        {
            var errorMessage = result.Message ?? "Đã xảy ra lỗi không xác định.";
            
            if (errorMessage.Contains("Tên nhà cung cấp đã tồn tại")) errors.Add("name", "Tên nhà cung cấp đã tồn tại.");
            if (errorMessage.Contains("Số điện thoại đã tồn tại")) errors.Add("phone", "Số điện thoại đã tồn tại.");
            if (errorMessage.Contains("Email đã tồn tại")) errors.Add("email", "Email đã tồn tại.");

            if (errors.Count == 0)
            {
                 apiError = errorMessage;
            }

            isSubmitting = false;
        }
    }
}