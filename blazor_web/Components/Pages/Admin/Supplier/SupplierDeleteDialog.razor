@page "/admin/suppliers/delete/{SupplierId:int}"
@layout AdminLayout
@rendermode InteractiveServer

@using blazor_web.DTOs.Supplier
@using blazor_web.Services.Supplier
@inject ISupplierService SupplierService
@inject NavigationManager Navigation
@using System.Web

<div class="fixed inset-0 bg-black/35 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-lg w-full max-w-md p-6">
        @if (isLoading)
        {
            <p class="text-center py-4">Đang tải thông tin...</p>
        }
        else if (SupplierData == null)
        {
            <h2 class="text-xl font-semibold text-red-600 mb-4">Lỗi</h2>
            <p class="text-gray-600 mb-6">Không tìm thấy nhà cung cấp để xóa.</p>
            <div class="flex justify-end">
                <button @onclick='() => Navigation.NavigateTo("/admin/suppliers")''
                        class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition">
                        Đóng
                    </button>
                </div>
        }
        else
        {
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Xóa nhà cung cấp</h2>
                <p class="text-gray-600 mb-6">
                    Bạn có chắc chắn muốn xóa
                    <span class="font-semibold text-red-600">@SupplierData.Name</span> khỏi hệ thống?
                    Hành động này không thể hoàn tác.
                </p>
                @if (!string.IsNullOrEmpty(apiError))
                {
                        <div class="mb-4 text-red-600 bg-red-50 p-3 rounded-lg text-sm">@apiError</div>
                }
                <div class="flex justify-end space-x-3">
                    <button @onclick=' ()=> Navigation.NavigateTo("/admin/suppliers")'
                    class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition"
                    disabled="@isSubmitting">
                    Hủy
                </button>
                <button @onclick="HandleConfirmDelete"
                    class="px-4 py-2 text-sm font-medium rounded-lg text-white bg-red-600 hover:bg-red-700"
                    disabled="@isSubmitting">
                    @(isSubmitting ? "Đang xóa..." : "Xóa")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int SupplierId { get; set; }

    private SupplierResponse? SupplierData;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? apiError;

    protected override async Task OnInitializedAsync()
    {
        await LoadSupplierData();
    }

    private async Task LoadSupplierData()
    {
        isLoading = true;

        var response = await SupplierService.GetSupplierByIdAsync(SupplierId);

        if (response.Success && response.Data != null)
        {
            SupplierData = response.Data;
        }
        else
        {
            SupplierData = null;
            apiError = response.Message;
        }
        isLoading = false;
    }

    private async Task HandleConfirmDelete()
    {
        isSubmitting = true;
        apiError = null;

        var response = await SupplierService.DeleteSupplierAsync(SupplierId);

        if (response.Success)
        {
            var message = $"Đã xóa nhà cung cấp '{SupplierData?.Name ?? "ID: " + SupplierId}' thành công.";

            var url =
            $"/admin/suppliers/alert?Title=Xóa%20thành%20công&Message={HttpUtility.UrlEncode(message)}&ReturnUrl={HttpUtility.UrlEncode("/admin/suppliers")}";

            Navigation.NavigateTo(url);
        }
        else
        {
            apiError = response.Message ?? "Xóa thất bại do lỗi không xác định.";
            isSubmitting = false;
        }
    }
}