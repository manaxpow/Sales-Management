@page "/admin/suppliers"
@layout AdminLayout
@rendermode InteractiveServer 

@using blazor_web.Models
@using blazor_web.DTOs.Supplier
@using blazor_web.Services.Supplier
@using blazor_web.Services.Product
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject NavigationManager Navigation
@inject ISupplierService SupplierService
@inject IProductService ProductService
@using blazor_web.Components.Pages.Admin.Supplier 

<div class="p-6 bg-gray-50 min-h-screen">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-semibold text-gray-800">
            Quản lý nhà cung cấp
        </h1>
        <div class="flex flex-wrap items-center gap-3">
            @* Tìm kiếm *@
            <input
                type="text"
                placeholder="Tìm kiếm nhà cung cấp..."
                @bind="searchTerm"
                @bind:event="oninput"
                class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-64 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />

            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button
                    @onclick="() => SetSearchTerm(string.Empty)"
                    class="px-3 py-2 text-sm rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 transition"
                >
                    &times;
                </button>
            }
        </div>
        
        <button
            @onclick="HandleCreate" 
            class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow transition"
        >
            @* Plus SVG *@
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            <span>Thêm mới</span>
        </button>
    </div>

    <div class="overflow-x-auto bg-white rounded-2xl shadow-md">
        <table class="w-full border-collapse text-sm">
            <thead>
                <tr class="bg-gray-100 text-gray-700 text-left">
                    <th class="py-3 px-4 font-semibold">ID</th>
                    <th class="py-3 px-4 font-semibold">Tên nhà cung cấp</th>
                    <th class="py-3 px-4 font-semibold">Số điện thoại</th>
                    <th class="py-3 px-4 font-semibold">Email</th>
                    <th class="py-3 px-4 font-semibold">Địa chỉ</th>
                    <th class="py-3 px-4 font-semibold text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="6" class="text-center py-6 text-gray-500">
                            <div class="flex justify-center items-center gap-2">
                                @* Loader2 SVG *@
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                                Đang tải dữ liệu...
                            </div>
                        </td>
                    </tr>
                }
                else if (currentSuppliers.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-6 text-gray-500">
                            Không có dữ liệu nhà cung cấp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var supplier in currentSuppliers)
                    {
                        var isChecking = checkingSupplierId == supplier.Id;
                        <tr key="@supplier.Id" class="border-t hover:bg-gray-50 transition @(isChecking ? "opacity-50" : "")">
                            <td class="py-3 px-4">@supplier.Id</td>
                            <td class="py-3 px-4 font-medium text-gray-800">@supplier.Name</td>
                            <td class="py-3 px-4">@supplier.Phone</td>
                            <td class="py-3 px-4">@supplier.Email</td>
                            <td class="py-3 px-4">@supplier.Address</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex justify-center gap-3">
                                    <button
                                        @onclick="() => HandleView(supplier)"
                                        class="text-blue-600 hover:text-blue-800 disabled:text-gray-300"
                                        title="Xem chi tiết"
                                        disabled="@isChecking"
                                    >
                                        @* Eye SVG *@
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    <button
                                        @onclick="() => HandleUpdate(supplier)"
                                        class="text-yellow-600 hover:text-yellow-700 disabled:text-gray-300"
                                        title="Chỉnh sửa"
                                        disabled="@isChecking"
                                    >
                                        @* Pencil SVG *@
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                    </button>
                                    <button
                                        @onclick="() => HandleDelete(supplier)"
                                        class="text-red-600 hover:text-red-700 disabled:text-gray-400"
                                        title="Xóa"
                                        disabled="@isChecking"
                                    >
                                        @if (isChecking)
                                        {
                                            @* Loader2 SVG (animate-spin) *@
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                                        }
                                        else
                                        {
                                            @* Trash2 SVG *@
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                        }
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @* Phân trang tùy chỉnh (Custom Pagination) *@
        <div class="flex justify-end items-center p-4 text-sm text-gray-700 border-t">
            <label for="rows-per-page" class="mr-2">Số hàng mỗi trang:</label>
            @* @bind="rowsPerPage" sử dụng setter C# để xử lý logic *@
            <select id="rows-per-page" @bind="rowsPerPage" class="border rounded-md px-2 py-1 mr-4">
                @foreach (var option in new[] { 5, 10, 25, 50 })
                {
                    <option value="@option">@option</option>
                }
            </select>
            
            <span class="mr-4">@(page * rowsPerPage + 1) - @Math.Min((page + 1) * rowsPerPage, filteredSuppliers.Count) trên tổng @filteredSuppliers.Count</span>

            <button @onclick="() => HandlePageChange(page - 1)" disabled="@(page == 0)" class="px-3 py-1 mx-1 rounded-lg hover:bg-gray-200 disabled:text-gray-400 disabled:bg-white">
                &lt;
            </button>
            <button @onclick="() => HandlePageChange(page + 1)" disabled="@((page + 1) * rowsPerPage >= filteredSuppliers.Count)" class="px-3 py-1 mx-1 rounded-lg hover:bg-gray-200 disabled:text-gray-400 disabled:bg-white">
                &gt;
            </button>
        </div>
    </div>

   
</div>


@code {
    private List<SupplierResponse> suppliers = new List<SupplierResponse>();
    private List<SupplierResponse> filteredSuppliers = new List<SupplierResponse>();
    private bool isLoading = false;
    private string _searchTerm = string.Empty;
    
    // Binding cho Search Term
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                // Gọi filter khi giá trị thay đổi
                OnSearchTermChanged();
            }
        }
    }

    // Phân trang
    private int _rowsPerPage = 10;
    private int page = 0;
    
    // Xử lý thay đổi rowsPerPage qua setter (sửa lỗi RZ10008)
    private int rowsPerPage
    {
        get => _rowsPerPage;
        set
        {
            if (_rowsPerPage != value)
            {
                _rowsPerPage = value;
                page = 0; // Reset trang về 0 khi thay đổi giới hạn hàng
                ApplyFilterAndPagination();
            }
        }
    }

    // Modal State (chỉ dùng cho Alert Modal)
    private bool alertModalOpen = false;
    private string alertModalMessage = string.Empty;
    
    private SupplierResponse? selectedSupplier = null;
    private int? checkingSupplierId = null;

    private List<SupplierResponse> currentSuppliers = new List<SupplierResponse>();


    protected override async Task OnInitializedAsync()
    {
        await FetchSuppliers();
    }

    private async Task FetchSuppliers()
    {
        isLoading = true;
        StateHasChanged(); 

        try
        {
            var response = await SupplierService.GetSuppliersAsync();
            if (response.Success && response.Data != null)
            {
                suppliers = response.Data;
            }
            else
            {
                Console.WriteLine($"API Error Response: {response.Message ?? "No message provided"}");
                suppliers = new List<SupplierResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching suppliers: {ex.Message}");
            suppliers = new List<SupplierResponse>();
        }
        finally
        {
            isLoading = false;
            ApplyFilterAndPagination();
        }
    }

    // Tương đương với logic filter và slice trong React
    private void ApplyFilterAndPagination()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredSuppliers = suppliers;
        }
        else
        {
            var search = searchTerm.ToLower();
            filteredSuppliers = suppliers
                .Where(s =>
                    s.Name.ToLower().Contains(search) ||
                    s.Phone.ToLower().Contains(search) ||
                    s.Email.ToLower().Contains(search) ||
                    (s.Address != null && s.Address.ToLower().Contains(search))
                )
                .ToList();
        }

        // Đảm bảo trang hiện tại hợp lệ sau khi filter
        if (page * rowsPerPage >= filteredSuppliers.Count && page > 0)
        {
            page = 0; 
        }

        // Áp dụng phân trang (Skip và Take)
        currentSuppliers = filteredSuppliers.Skip(page * rowsPerPage).Take(rowsPerPage).ToList();
        
        StateHasChanged();
    }

    private void SetSearchTerm(string value)
    {
        searchTerm = value; 
    }

    private void OnSearchTermChanged()
    {
        page = 0;
        ApplyFilterAndPagination();
    }
    
    private void HandlePageChange(int newPage)
    {
        page = newPage;
        ApplyFilterAndPagination();
    }

    private void HandleCreate()
    {
        Navigation.NavigateTo("/admin/suppliers/create");
    }

    private void HandleView(SupplierResponse supplier)
    {
        Navigation.NavigateTo($"/admin/products/supplier/{supplier.Id}");
    }

    private void HandleUpdate(SupplierResponse supplier)
    {
        Navigation.NavigateTo($"/admin/suppliers/edit/{supplier.Id}");
    }

    private async Task HandleDelete(SupplierResponse supplier)
    {
        if (checkingSupplierId.HasValue) return;

        checkingSupplierId = supplier.Id;
        selectedSupplier = supplier;
        StateHasChanged(); 

        try
        {
            var response = await ProductService.GetProductsBySupplierIdAsync(supplier.Id);

            if (response.Success)
            {
                if (response.Data != null && response.Data.Count > 0)
                {
                    var message = $"Không thể xóa \"{supplier.Name}\" vì đang có {response.Data.Count} sản phẩm liên quan.";
                    var url = $"/admin/suppliers/alert?Title=Không%20thể%20xóa&Message={System.Web.HttpUtility.UrlEncode(message)}&ReturnUrl={System.Web.HttpUtility.UrlEncode("/admin/suppliers")}";

                    Navigation.NavigateTo(url);
                }
                else
                {
                    Navigation.NavigateTo($"/admin/suppliers/delete/{supplier.Id}");
                }
            }
            else
            {
                var message = response.Message ?? "Lỗi khi kiểm tra sản phẩm.";
                var url = $"/admin/suppliers/alert?Title=Lỗi%20kiểm%20tra&Message={System.Web.HttpUtility.UrlEncode(message)}&ReturnUrl={System.Web.HttpUtility.UrlEncode("/admin/suppliers")}";
                Navigation.NavigateTo(url);
            }
        }
        catch (Exception ex)
        {
            var message = $"Đã xảy ra lỗi";
            var url = $"/admin/suppliers/alert?Title=Lỗi%20hệ%20thống&Message={System.Web.HttpUtility.UrlEncode(message)}&ReturnUrl={System.Web.HttpUtility.UrlEncode("/admin/suppliers")}";
            Navigation.NavigateTo(url);
        }
        finally
        {
            checkingSupplierId = null;
        }
    }
}