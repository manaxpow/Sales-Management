@page "/admin/suppliers"
@layout AdminLayout
@rendermode InteractiveServer

@using blazor_web.Models
@using blazor_web.DTOs.Supplier
@using blazor_web.Services.Supplier
@using blazor_web.Services.Product
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject NavigationManager Navigation
@inject ISupplierService SupplierService
@inject IProductService ProductService
@using blazor_web.Components.Pages.Admin.Supplier
@using System.Web

<div class="p-4 bg-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-dark">
            Quản lý nhà cung cấp
        </h1>
        <div class="d-flex flex-wrap align-items-center gap-2">

            <div class="input-group input-group-sm w-auto">
                <input type="text" placeholder="Tìm kiếm" @bind="searchTerm" @bind:event="oninput" class="form-control"
                    style="width: 200px;" />

                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button @onclick="() => SetSearchTerm(string.Empty)" class="btn btn-outline-secondary"
                        title="Xóa tìm kiếm">
                        &times;
                    </button>
                }
            </div>

            <button @onclick="HandleCreate" class="btn btn-primary rounded-2 d-flex align-items-center gap-1 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14" />
                    <path d="M12 5v14" />
                </svg>
                <span>Thêm mới</span>
            </button>
        </div>
    </div>

    <div class="card shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-borderless mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary">
                            <th scope="col" class="py-3 px-4">ID</th>
                            <th scope="col" class="py-3 px-4">Tên nhà cung cấp</th>
                            <th scope="col" class="py-3 px-4">Số điện thoại</th>
                            <th scope="col" class="py-3 px-4">Email</th>
                            <th scope="col" class="py-3 px-4">Địa chỉ</th>
                            <th scope="col" class="py-3 px-4 text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        Đang tải dữ liệu...
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (currentSuppliers.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    Không có dữ liệu nhà cung cấp.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var supplier in currentSuppliers)
                            {
                                var isChecking = checkingSupplierId == supplier.Id;
                                <tr key="@supplier.Id" class="@(isChecking ? "opacity-50" : "")">
                                    <td class="py-3 px-4">@supplier.Id</td>
                                    <td class="py-3 px-4 fw-bold text-dark">@supplier.Name</td>
                                    <td class="py-3 px-4">@supplier.Phone</td>
                                    <td class="py-3 px-4">@supplier.Email</td>
                                    <td class="py-3 px-4">@supplier.Address</td>
                                    <td class="py-3 px-4 text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button @onclick="() => HandleView(supplier)" class="btn btn-sm text-info border-0"
                                                title="Xem chi tiết" disabled="@isChecking">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                    stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                                    <circle cx="12" cy="12" r="3" />
                                                </svg>
                                            </button>
                                            <button @onclick="() => HandleUpdate(supplier)"
                                                class="btn btn-sm text-warning border-0" title="Chỉnh sửa"
                                                disabled="@isChecking">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                    stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                                                </svg>
                                            </button>
                                            <button @onclick="() => HandleDelete(supplier)"
                                                class="btn btn-sm text-danger border-0" title="Xóa" disabled="@isChecking">
                                                @if (isChecking)
                                                {
                                                    <div class="spinner-border spinner-border-sm" role="status"></div>
                                                }
                                                else
                                                {
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                        stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M3 6h18" />
                                                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                                                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                                                    </svg>
                                                }
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (filteredSuppliers.Count > 0)
    {
        <div class="mt-3 card card-body p-0">
            <SupplierPagination CurrentPage="@(page + 1)"
                TotalPages="@((int)Math.Ceiling((double)filteredSuppliers.Count / rowsPerPage))"
                TotalItems="@filteredSuppliers.Count" ItemsPerPage="@rowsPerPage" OnPageChanged="HandlePaginationChange"
                OnItemsPerPageChanged="HandlePageSizeChange" />
        </div>
    }
</div>

<SupplierDeleteDialog @ref="deleteDialog" OnDeleteSuccess="HandleDeleteSuccess" />
<AlertModalDialog @ref="alertDialog" />


@code {
    private SupplierDeleteDialog? deleteDialog;
    private AlertModalDialog? alertDialog;

    private List<SupplierResponse> suppliers = new List<SupplierResponse>();
    private List<SupplierResponse> filteredSuppliers = new List<SupplierResponse>();
    private bool isLoading = false;
    private string _searchTerm = string.Empty;

    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                OnSearchTermChanged();
            }
        }
    }

    private int _rowsPerPage = 5;
    private int page = 0;

    private int rowsPerPage
    {
        get => _rowsPerPage;
        set
        {
            if (_rowsPerPage != value)
            {
                _rowsPerPage = value;
                page = 0;
                ApplyFilterAndPagination();
            }
        }
    }

    private SupplierResponse? selectedSupplier = null;
    private int? checkingSupplierId = null;

    private List<SupplierResponse> currentSuppliers = new List<SupplierResponse>();


    protected override async Task OnInitializedAsync()
    {
        await FetchSuppliers();
    }

    private async Task FetchSuppliers()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await SupplierService.GetSuppliersAsync();
            if (response.Success && response.Data != null)
            {
                suppliers = response.Data;
            }
            else
            {
                Console.WriteLine($"API Error Response: {response.Message ?? "No message provided"}");
                suppliers = new List<SupplierResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching suppliers: {ex.Message}");
            suppliers = new List<SupplierResponse>();
        }
        finally
        {
            isLoading = false;
            ApplyFilterAndPagination();
        }
    }

    private void ApplyFilterAndPagination()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredSuppliers = suppliers;
        }
        else
        {
            var search = searchTerm.ToLower();
            filteredSuppliers = suppliers
            .Where(s =>
            s.Name.ToLower().Contains(search) ||
            s.Phone.ToLower().Contains(search) ||
            s.Email.ToLower().Contains(search) ||
            (s.Address != null && s.Address.ToLower().Contains(search))
            )
            .ToList();
        }

        if (page * rowsPerPage >= filteredSuppliers.Count && page > 0)
        {
            page = 0;
        }

        currentSuppliers = filteredSuppliers.Skip(page * rowsPerPage).Take(rowsPerPage).ToList();

        StateHasChanged();
    }

    private void SetSearchTerm(string value)
    {
        searchTerm = value;
    }

    private void OnSearchTermChanged()
    {
        page = 0;
        ApplyFilterAndPagination();
    }

    private void HandlePaginationChange(int newPage)
    {
        page = newPage - 1;
        ApplyFilterAndPagination();
    }

    private void HandlePageSizeChange(int newPageSize)
    {
        rowsPerPage = newPageSize;
    }

    private void HandleCreate()
    {
        Navigation.NavigateTo("/admin/suppliers/create");
    }

    private void HandleView(SupplierResponse supplier)
    {
        Navigation.NavigateTo($"/admin/products/supplier/{supplier.Id}");
    }

    private void HandleUpdate(SupplierResponse supplier)
    {
        Navigation.NavigateTo($"/admin/suppliers/edit/{supplier.Id}");
    }

    private async Task HandleDeleteSuccess(string deletedName)
    {
        var message = $"Đã xóa nhà cung cấp '{deletedName}' thành công.";
        if (alertDialog != null)
        {
            alertDialog.Show(
            title: "Thành công",
            message: message,
            type: "success" 
            );
        }

        await FetchSuppliers();
    }
    private async Task HandleDelete(SupplierResponse supplier)
    {
        if (checkingSupplierId.HasValue) return;

        checkingSupplierId = supplier.Id;
        selectedSupplier = supplier;
        StateHasChanged();

        try
        {
            var response = await ProductService.GetProductsBySupplierIdAsync(supplier.Id);

            if (response.Success)
            {
                if (response.Data != null && response.Data.Count > 0)
                {
                    var message = $"Không thể xóa \"{supplier.Name}\" vì đang có {response.Data.Count} sản phẩm liên quan.";

                    if (alertDialog != null)
                    {
                        alertDialog.Show(
                        title: "Không thể xóa",
                        message: message,
                        type: "warning"
                        );
                    }
                }
                else
                {
                    if (deleteDialog != null)
                    {
                        await deleteDialog.Show(supplier.Id);
                    }
                }
            }
            else
            {
                var message = response.Message ?? "Lỗi khi kiểm tra sản phẩm.";
                if (alertDialog != null)
                {
                    alertDialog.Show(
                    title: "Lỗi kiểm tra",
                    message: "Vui lòng thử lại sau.",
                    type: "error",
                    detail: message
                    );
                }
            }
        }
        catch (Exception ex)
        {
            if (alertDialog != null)
            {
                alertDialog.Show(
                title: "Lỗi hệ thống",
                message: "Đã xảy ra lỗi mạng. Vui lòng thử lại.",
                type: "error",
                detail: ex.Message
                );
            }
        }
        finally
        {
            checkingSupplierId = null;
            StateHasChanged();
        }
    }
}