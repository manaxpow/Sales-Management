<ProtectedRoute RequiredRoles="admin"/>

@using Microsoft.AspNetCore.Components.Web

<div class="d-flex align-items-center justify-content-between border-top bg-white px-4 py-3 border-light"> @* border-light thay cho border-gray-200 *@
    
    @* Mobile View: Hiển thị trên màn hình nhỏ *@
    <div class="d-flex d-sm-none justify-content-between w-100">
        <button @onclick="GoToPrevious" disabled="@IsPreviousDisabled"
            class="btn btn-outline-secondary btn-sm"> @* btn-outline-secondary, btn-sm là của Bootstrap *@
            Trước
        </button>
        <button @onclick="GoToNext" disabled="@IsNextDisabled"
            class="btn btn-outline-secondary btn-sm ms-3"> @* ms-3: margin-start 3 (tương đương ml-3) *@
            Sau
        </button>
    </div>

    @* Desktop View: Hiển thị trên màn hình lớn *@
    <div class="d-none d-sm-flex w-100 align-items-center justify-content-between">
        <div>
            <p class="text-sm text-muted mb-0"> @* text-muted thay cho text-gray-700, mb-0 để loại bỏ margin bottom *@
                Hiển thị <span class="fw-bold">@StartItem</span> đến <span class="fw-bold">@EndItem</span>
                trong tổng số <span class="fw-bold">@TotalItems</span> kết quả
            </p>
        </div>

        <div class="d-flex align-items-center gap-4"> @* gap-4: Để tạo khoảng cách giữa các phần tử *@

            @* Phần chọn số lượng hàng *@
            <div class="d-flex align-items-center">
                <label for="rows-select" class="me-2 text-sm text-muted text-nowrap">Hiển thị:</label> @* me-2: margin-end 2 *@
                <select id="rows-select" value="@ItemsPerPage" @onchange="OnPageSizeChange"
                    class="form-select form-select-sm w-auto"> @* form-select, form-select-sm, w-auto là của Bootstrap *@
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>

            @* Phần Phân trang *@
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0"> @* pagination, pagination-sm là của Bootstrap *@

                    @* Nút Quay lại *@
                    <li class="page-item @(IsPreviousDisabled ? "disabled" : "")">
                        <button @onclick="GoToPrevious" disabled="@IsPreviousDisabled"
                            class="page-link" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span> @* Ký tự mũi tên Bootstrap *@
                        </button>
                    </li>

                    @* Các nút số trang *@
                    @foreach (var pageNum in PageNumbers)
                    {
                        <li class="page-item @(pageNum == CurrentPage ? "active" : "")">
                            <button @onclick="() => GoToPage(pageNum)" 
                                class="page-link">
                                @pageNum
                            </button>
                        </li>
                    }

                    @* Nút Kế tiếp *@
                    <li class="page-item @(IsNextDisabled ? "disabled" : "")">
                        <button @onclick="GoToNext" disabled="@IsNextDisabled"
                            class="page-link" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span> @* Ký tự mũi tên Bootstrap *@
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public int TotalItems { get; set; } = 0;
    [Parameter] public int ItemsPerPage { get; set; } = 5;

    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> OnItemsPerPageChanged { get; set; }

    private List<int> PageSizeOptions = new() { 5, 10, 15, 20 };

    private int StartItem => TotalItems == 0 ? 0 : (CurrentPage - 1) * ItemsPerPage + 1;
    private int EndItem => Math.Min(CurrentPage * ItemsPerPage, TotalItems);
    private bool IsPreviousDisabled => CurrentPage <= 1;
    private bool IsNextDisabled => CurrentPage >= TotalPages || TotalPages == 0;

    private IEnumerable<int> PageNumbers
    {
        get
        {
            // Giữ nguyên logic tính toán số trang để hiển thị
            if (TotalPages <= 7) return Enumerable.Range(1, TotalPages);

            var start = Math.Max(1, CurrentPage - 2);
            var end = Math.Min(TotalPages, CurrentPage + 2);

            if (CurrentPage <= 3) end = Math.Min(5, TotalPages);
            else if (CurrentPage >= TotalPages - 2) start = Math.Max(1, TotalPages - 4);

            return Enumerable.Range(start, end - start + 1);
        }
    }
    
    // Đã loại bỏ GetPageButtonClass() vì Bootstrap tự động xử lý active/disabled thông qua class của <li> và <button>

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }

    private async Task GoToPrevious()
    {
        if (!IsPreviousDisabled) await GoToPage(CurrentPage - 1);
    }

    private async Task GoToNext()
    {
        if (!IsNextDisabled) await GoToPage(CurrentPage + 1);
    }

    private async Task OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            await OnItemsPerPageChanged.InvokeAsync(newSize);
        }
    }
}