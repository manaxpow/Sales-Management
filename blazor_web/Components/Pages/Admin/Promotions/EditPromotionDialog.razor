@using blazor_web.Models
@inject IPromotionService promotionService

@if (ShowDialog)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow-lg">

                <div class="modal-header">
                    <h5 class="modal-title">Edit Promotion</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>


                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-md">
                        <div class="flex">
                            <svg class="h-5 w-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                    clip-rule="evenodd" />
                            </svg>
                            <span class="text-sm">@ErrorMessage</span>
                        </div>
                    </div>
                }

                <!-- Success Messages -->
                @if (!string.IsNullOrEmpty(SuccessMessage))
                {
                    <div class="bg-green-50 border border-green-200 text-green-600 px-4 py-3 rounded-md">
                        <div class="flex">
                            <svg class="h-5 w-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                    clip-rule="evenodd" />
                            </svg>
                            <span class="text-sm">@SuccessMessage</span>
                        </div>
                    </div>
                }
                <EditForm Model="@PromotionEditModel" OnValidSubmit="HandleSave">
                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        <!-- CODE PROMOTION -->
                        <div class="mb-3">
                            <label>Code promotion</label>
                            <InputText class="form-control" @bind-Value="PromotionEditModel.PromotionCode"
                                disabled="@IsReadOnly" />
                            <ValidationMessage For="@(() => PromotionEditModel.PromotionCode)" class="text-danger small" />
                        </div>

                        <!-- DESCRIPTION -->
                        <div class="mb-3">
                            <label>Description</label>
                            <InputText class="form-control" @bind-Value="PromotionEditModel.Description"
                                disabled="@IsReadOnly" />
                            <ValidationMessage For="@(() => PromotionEditModel.Description)" class="text-danger small" />
                        </div>

                        <!-- DISCOUNT TYPE -->
                        <div class="mb-3">
                            <label>Discount type</label>
                            <InputSelect class="form-select" @bind-Value="PromotionEditModel.DiscountType" disabled="true">
                                @foreach (var t in Enum.GetValues<DiscountTypeEnum>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => PromotionEditModel.DiscountType)" class="text-danger small" />
                        </div>

                        <!-- DISCOUNT VALUE -->
                        <div class="mb-3">
                            <label>Discount value</label>
                            <InputNumber class="form-control" @bind-Value="PromotionEditModel.DiscountValue"
                                disabled="@IsReadOnly" />
                            <ValidationMessage For="@(() => PromotionEditModel.DiscountValue)" class="text-danger small" />
                        </div>

                        <!-- USAGE LIMIT -->
                        <div class="mb-3">
                            <label>Usage limit</label>
                            <InputNumber class="form-control" @bind-Value="PromotionEditModel.UsageLimit"
                                disabled="@IsReadOnly" />
                            <ValidationMessage For="@(() => PromotionEditModel.UsageLimit)" class="text-danger small" />
                        </div>

                        <!-- MIN ORDER AMOUNT -->
                        <div class="mb-3">
                            <label>Min order amount</label>
                            <InputNumber class="form-control" @bind-Value="PromotionEditModel.MinOrderAmount"
                                disabled="@IsReadOnly" />
                            <ValidationMessage For="@(() => PromotionEditModel.MinOrderAmount)" class="text-danger small" />
                        </div>

                        <!-- START DATE -->
                        <div class="mb-3">
                            <label>Start date</label>
                            <InputDate class="form-control" @bind-Value="PromotionEditModel.StartDate"
                                disabled="@IsReadOnly" />
                            <ValidationMessage For="@(() => PromotionEditModel.StartDate)" class="text-danger small" />
                        </div>

                        <!-- END DATE -->
                        <div class="mb-3">
                            <label>End date</label>
                            <InputDate class="form-control" @bind-Value="PromotionEditModel.EndDate"
                                disabled="@IsReadOnly" />
                            <ValidationMessage For="@(() => PromotionEditModel.EndDate)" class="text-danger small" />
                        </div>

                        <!-- STATUS -->
                        <div class="mb-3">
                            <label>Status</label>
                            <InputSelect class="form-select" @bind-Value="PromotionEditModel.Status" disabled="@IsReadOnly">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => PromotionEditModel.Status)" class="text-danger small" />
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="Close">Cancel</button>

                        @if (!IsReadOnly)
                        {
                            <button class="btn btn-primary" type="submit">Save changes</button>
                        }
                    </div>
                </EditForm>


            </div>
        </div>
    </div>
}

@code {

    public bool ShowDialog { get; set; }

    private EditPromotionModal PromotionEditModel = new();
    [Parameter] public EventCallback<PromotionRes> OnSave { get; set; }
    bool IsReadOnly =>
    DateOnly.FromDateTime(DateTime.Today) >= PromotionEditModel.StartDate &&
    DateOnly.FromDateTime(DateTime.Today) <= PromotionEditModel.EndDate;

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    public void Show(PromotionRes p)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        PromotionEditModel = new EditPromotionModal
        {
            PromotionCode = p.Code,
            Description = p.Description,
            DiscountType = (DiscountTypeEnum)p.DiscountType,
            DiscountValue = p.DiscountValue,
            UsageLimit = p.UsageLimit,
            MinOrderAmount = p.MinOrderAmount,
            StartDate = DateOnly.FromDateTime(p.StartDate),
            EndDate = DateOnly.FromDateTime(p.EndDate),
            Status = (StatusTypeEnum)p.Status,
            Id = p.Id
        };

        ShowDialog = true;
        StateHasChanged();
    }

    public void Close()
    {
        ShowDialog = false;
        StateHasChanged();
    }

    private async Task HandleSave()
    {
        var req = new UpdatePromotionReq
        {
            Id = PromotionEditModel.Id,
            PromotionCode = PromotionEditModel.PromotionCode,
            Description = PromotionEditModel.Description,
            DiscountType = (int)PromotionEditModel.DiscountType,
            DiscountValue = PromotionEditModel.DiscountValue,
            UsageLimit = PromotionEditModel.UsageLimit,
            MinOrderAmount = PromotionEditModel.MinOrderAmount,
            StartDate = PromotionEditModel.StartDate.ToString("yyyy/MM/dd"),
            EndDate = PromotionEditModel.EndDate.ToString("yyyy/MM/dd"),
            Status = (int)PromotionEditModel.Status
        };

        await promotionService.UpdatePromotion(req);

        var result = await promotionService.UpdatePromotion(req);
        Console.WriteLine($"API call completed. Success: {result.Success}, Message: {result.Message}");


        if (result.Success && result.Data != null)
        {
            // Store login information in localStorage
            SuccessMessage = "Promotion update successfully";
        }
        else
        {
            // Show error message without redirecting (preserves form data)
            SuccessMessage = null;
            ErrorMessage = !string.IsNullOrEmpty(result.Message)
            ? result.Message
            : "Created failed. Please try again.";
        }
        await OnSave.InvokeAsync(result.Data);
    }
}