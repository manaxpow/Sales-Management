@using blazor_web.Models
    
@inject IProductService productService

@if (ShowDialog)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); z-index: 99;">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title text-danger">Xác nhận xóa sản phẩm</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body">
                    @if (IsReadOnly)
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>Chú ý!</strong> Sản phẩm hiện đang được sử dụng trong hệ thống.
                            Không thể xóa sản phẩm này khi vẫn còn đơn hàng liên quan.
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="Close">Đóng</button>
                            <button disabled class="btn btn-danger">Xóa</button>
                        </div>
                    }
                    else
                    {
                        <p>Bạn có chắc muốn xóa sản phẩm <b>@_productName</b> không?</p>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="Close">Hủy</button>
                            <button class="btn btn-danger" @onclick="ConfirmDelete">Xóa</button>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
}

@code {
    public bool ShowDialog { get; set; }

    private int _productId;
    private string _productName = "";
    private bool IsReadOnly;

    // Callback cho parent
    [Parameter] public EventCallback<int> OnSave { get; set; }

    // Show dialog
    public void Show(ProductResponse product)
    {
        _productId = product.ProductId;
        _productName = product.ProductName;

        // Nếu sản phẩm còn tồn tại trong đơn hàng => không cho xóa
        IsReadOnly = false;

        ShowDialog = true;
        StateHasChanged();
    }

    public void Close()
    {
        ShowDialog = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        var req = new DeleteProductRequest
        {
            ProductId = _productId
        };

        Console.WriteLine("Gọi API xóa sản phẩm...");

        var result = await productService.DeleteProduct(req);


        Console.WriteLine($"API completed. Success: {result.Success}, Message: {result.Message}");
        
        // Trả ID về parent để reload list
        await OnSave.InvokeAsync(_productId);

        Close();
    }
}