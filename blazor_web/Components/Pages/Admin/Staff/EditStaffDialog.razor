@using blazor_web.DTOs.User
@using blazor_web.Models 

@if (ShowDialog)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cập nhật nhân viên</h5>
                    @if (!isSaving)
                    {
                        <button type="button" class="btn-close" @onclick="Close"></button>
                    }
                </div>
                <div class="modal-body">
                    @* --- HIỂN THỊ LỖI TỪ SERVER --- *@
                    @if (!string.IsNullOrEmpty(serverError))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="oi oi-warning"></i> <small>@serverError</small>
                            <button type="button" class="btn-close" @onclick="() => serverError = null"></button>
                        </div>
                    }
                    
                    @* Thêm OnInvalidSubmit để debug nếu form lỗi *@
                    <EditForm Model="@editModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                        <DataAnnotationsValidator />
                        
                        @* 1. Tên đăng nhập (Readonly) *@
                        <div class="mb-3">
                            <label class="form-label">Tên đăng nhập</label>
                            <InputText class="form-control" @bind-Value="editModel.UserName" disabled /> 
                            <small class="text-muted">Không thể thay đổi tên đăng nhập</small>
                        </div>

                        @* 2. Họ tên *@
                        <div class="mb-3">
                            <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="editModel.FullName" />
                            <ValidationMessage For="@(() => editModel.FullName)" class="text-danger" />
                        </div>
                        
                        @* 4. Vai trò *@
                        <div class="mb-3">
                            <label class="form-label">Vai trò</label>
                            <InputSelect class="form-select" @bind-Value="editModel.Role">
                                <option value="Staff">Nhân viên (Staff)</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => editModel.Role)" class="text-danger" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@isSaving">Hủy</button>
                            
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span> Đang lưu...</span>
                                }
                                else
                                {
                                    <span>Lưu thay đổi</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public bool ShowDialog { get; private set; }
    
    private Users editModel = new Users();
    private bool isSaving = false;
    private string? serverError;

    [Parameter] 
    public Func<UserResponse, Task<ApiResponse<UserResponse>>> OnSave { get; set; }

    public void Show(UserResponse user)
    {
        // Reset model
        editModel = new Users
        {
            Id = user.Id,
            UserName = user.UserName,
            FullName = user.FullName,
            Role = "Staff",
            Password = "DUMMY_PASSWORD_UNCHANGED" 
        };
        
        serverError = null;
        ShowDialog = true;
        isSaving = false;
        StateHasChanged();
    }

    public void Close()
    {
        if (!isSaving)
        {
            ShowDialog = false;
            StateHasChanged();
        }
    }

    private void HandleInvalidSubmit()
    {
        Console.WriteLine("--- FORM INVALID ---");
        if (string.IsNullOrEmpty(editModel.Password)) Console.WriteLine("Lỗi: Password đang trống");
        if (string.IsNullOrEmpty(editModel.FullName)) Console.WriteLine("Lỗi: FullName đang trống");
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        serverError = null;
        StateHasChanged();

        // Map dữ liệu từ Form sang DTO trả về cho cha
        var updatedUserDto = new UserResponse
        {
            Id = editModel.Id,
            UserName = editModel.UserName,
            FullName = editModel.FullName,
            Role = editModel.Role
        };

        // Gọi cha (UserList)
        var result = await OnSave(updatedUserDto);

        if (result.Success)
        {
            ShowDialog = false; 
        }
        else
        {
            serverError = !string.IsNullOrEmpty(result.Message) 
                          ? result.Message 
                          : "Lỗi không xác định từ Server.";
        }

        isSaving = false;
        StateHasChanged();
    }
}