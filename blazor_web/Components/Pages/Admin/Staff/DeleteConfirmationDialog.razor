@if (ShowDialog)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="oi oi-warning"></i> Xác nhận xóa
                    </h5>
                    @if (!isDeleting)
                    {
                        <button type="button" class="btn-close" @onclick="Close"></button>
                    }
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc chắn muốn xóa khách hàng <strong class="text-primary">@_customerName</strong> không?</p>
                    <p class="text-muted small">Hành động này không thể hoàn tác.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@isDeleting">
                        Hủy
                    </button>
                    
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Đang xóa...</span>
                        }
                        else
                        {
                            <span>Xóa</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public bool ShowDialog { get; private set; }
    
    private int _customerId;
    private string _customerName = "";
    private bool isDeleting = false; 

    [Parameter] 
    public EventCallback<int> OnConfirm { get; set; }

    public void Show(int id, string name)
    {
        _customerId = id;
        _customerName = name;
        ShowDialog = true;
        isDeleting = false; 
        StateHasChanged();
    }

    public void Close()
    {
        if (!isDeleting)
        {
            ShowDialog = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete()
    {
        isDeleting = true;
        StateHasChanged(); 

        await OnConfirm.InvokeAsync(_customerId);

        isDeleting = false;
        ShowDialog = false;
        StateHasChanged();
    }
}