@page "/admin/staffs"
@using blazor_web.DTOs.User
@using blazor_web.Models
@inject blazor_web.Services.User.IUserService UserService
@rendermode @(new InteractiveServerRenderMode(prerender: false))
<ProtectedRoute RequiredRoles="admin"/>


<h3>Quản lý Nhân viên (Staff)</h3>

<div class="d-flex justify-content-between mb-3 align-items-center">
    @* Ô tìm kiếm *@
    <div class="input-group w-50">
        <input type="text" class="form-control" placeholder="Tìm theo tên đăng nhập, họ tên..."
               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch"/>
        <span class="input-group-text">
            <i class="oi oi-magnifying-glass"></i>
        </span>
    </div>

    @* Nút thêm mới - trỏ về trang Create User *@
    <a href="/admin/staffs/create" class="btn btn-primary">
        <i class="oi oi-plus"></i> Thêm mới
    </a>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <table class="table table-bordered table-striped table-hover">
        <thead>
        <tr>
            <th>ID</th>
            <th>User Name</th>
            <th>Full Name</th>
            <th>Role</th>
            <th>Created At</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        @if (users != null && users.Any())
        {
            @foreach (var item in users)
            {
                <tr>
                    <td>@item.Id</td>
                    <td class="fw-bold text-primary">@item.UserName</td>
                    <td>@item.FullName</td>
                    <td>
                        @* Badge hiển thị Role *@
                        <span class="badge @(item.Role == "Admin" ? "bg-danger" : "bg-success")">
                            @item.Role
                        </span>
                    </td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="() => OpenEditDialog(item)">
                            Sửa
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => OpenDeleteDialog(item)">
                            Xóa
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-3">
                    Không tìm thấy nhân viên nào
                </td>
            </tr>
        }
        </tbody>
    </table>

    @* Phân trang *@
    <div class="d-flex justify-content-between align-items-center">
        <span>Hiển thị trang @currentPage / @totalPages (Tổng: @totalRecords)</span>
        <nav>
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Trước</button>
                </li>
                <li class="page-item active">
                    <span class="page-link">@currentPage</span>
                </li>
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Sau</button>
                </li>
            </ul>
        </nav>
    </div>
}

<EditStaffDialog @ref="editDialog" OnSave="SaveUserAsync"/>
<DeleteConfirmationDialog @ref="deleteDialog" OnConfirm="DeleteUserAsync"/>

@code {

    // Đổi sang UserResponse
    private IEnumerable<UserResponse> users = new List<UserResponse>();
    private bool isLoading = true;

    // Pagination & Search
    private string searchTerm = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalRecords = 0;

    private System.Timers.Timer? _debounceTimer;
    private EditStaffDialog editDialog = default!;
    private DeleteConfirmationDialog deleteDialog = default!;

    protected override async Task OnInitializedAsync()
    {
        _debounceTimer = new System.Timers.Timer(500);
        _debounceTimer.Elapsed += async (sender, e) => await InvokeAsync(async () => await LoadData());
        _debounceTimer.AutoReset = false;

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new GetUserRequest
            {
                Page = currentPage,
                Limit = pageSize,
                Search = searchTerm,
                Role = "staff"
            };

            var response = await UserService.GetAllUsersAsync(request);

            if (response.Success && response.Data != null)
            {
                users = response.Data.Users;
                totalRecords = response.Data.Total;
                totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

                currentPage = response.Data.Page;
            }
            else
            {
                users = new List<UserResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading users: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void HandleSearch()
    {
        currentPage = 1;
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > totalPages) return;
        currentPage = newPage;
        await LoadData();
    }

    // --- LOGIC DELETE ---
    private void OpenDeleteDialog(UserResponse user)
    {
        // Hiển thị tên user cần xóa
        deleteDialog.Show(user.Id, user.UserName);
    }

    private async Task DeleteUserAsync(int id)
    {
        var result = await UserService.DeleteUserAsync(id);
        if (result.Success)
        {
            await LoadData();
        }
        else
        {
            Console.WriteLine($"Delete failed: {result.Message}");
        }
    }

    // --- LOGIC EDIT ---
    private void OpenEditDialog(UserResponse user)
    {
        editDialog.Show(user);
    }

    private async Task<ApiResponse<UserResponse>> SaveUserAsync(UserResponse updatedData)
    {
        var userEntity = new UpdateUserRequest
        {
            FullName = updatedData.FullName,
            Role = updatedData.Role,
        };

        var result = await UserService.UpdateUserAsync(updatedData.Id, userEntity);

        if (result.Success)
        {
            await LoadData();
        }

        return result;
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

}