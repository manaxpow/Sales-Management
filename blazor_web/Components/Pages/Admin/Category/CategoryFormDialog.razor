@using blazor_web.Components.Pages.Admin.Category

<div class="@(Open ? "modal fade show d-block" : "modal d-none")" tabindex="-1" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">@(Initial != null ? "Sửa danh mục" : "Thêm mới danh mục")</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" 
                           @bind="Name" @bind:event="oninput"
                           @onkeydown="OnKeyDown"
                           placeholder="Nhập tên danh mục..." 
                           autofocus />
                    @if (string.IsNullOrWhiteSpace(Name) && isTouched)
                    {
                        <div class="text-danger small mt-1">Tên danh mục không được để trống.</div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnClose">Hủy</button>
                <button type="button" class="btn btn-primary" 
                        disabled="@string.IsNullOrWhiteSpace(Name)"
                        @onclick="HandleSave">
                    <i class="bi bi-save me-1"></i> Lưu lại
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public CategoryFormDialog.CategoryDto? Initial { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(string Name, int? Id)> OnSave { get; set; }

    private string Name { get; set; } = string.Empty;
    private bool isTouched = false;
    private bool _previousOpen = false;

    // Chỉ reset dữ liệu khi Dialog CHUYỂN từ Đóng -> Mở
    protected override void OnParametersSet()
    {
        if (Open && !_previousOpen)
        {
            Name = Initial?.Name ?? string.Empty;
            isTouched = false;
        }
        _previousOpen = Open;
    }

    private async Task HandleSave()
    {
        isTouched = true;
        if (string.IsNullOrWhiteSpace(Name)) return;
        await OnSave.InvokeAsync((Name.Trim(), Initial?.Id));
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSave();
    }
    
    // DTO riêng cho Form để tránh xung đột
    public class CategoryDto
    {
        public int? Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}