<div class="@(Open ? "modal fade show d-block" : "modal d-none")" tabindex="-1" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger">Xác nhận xóa</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa danh mục <br/> <strong class="text-primary">@(Name ?? "này")</strong> không?</p>
                <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light" @onclick="OnClose">Hủy</button>
                <button type="button" class="btn btn-danger" @onclick="HandleDelete">Xóa bỏ</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task HandleDelete()
    {
        await OnConfirm.InvokeAsync();
    }
}