@using blazor_web.DTOs.Customer
@using blazor_web.Models 

@if (ShowDialog)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cập nhật khách hàng</h5>
                    @if (!isSaving)
                    {
                        <button type="button" class="btn-close" @onclick="Close"></button>
                    }
                </div>
                <div class="modal-body">
                    @* --- HIỂN THỊ LỖI TỪ SERVER --- *@
                    @if (!string.IsNullOrEmpty(serverError))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="oi oi-warning"></i> <small>@serverError</small>
                            <button type="button" class="btn-close" @onclick="() => serverError = null"></button>
                        </div>
                    }
                    
                    <EditForm Model="@editModel" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        
                        <div class="mb-3">
                            <label class="form-label">Tên <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="editModel.Name" />
                            <ValidationMessage For="@(() => editModel.Name)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">SĐT <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="editModel.Phone" />
                            <ValidationMessage For="@(() => editModel.Phone)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="editModel.Email" />
                            <ValidationMessage For="@(() => editModel.Email)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="editModel.Address" />
                            <ValidationMessage For="@(() => editModel.Address)" class="text-danger" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@isSaving">Hủy</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span> Đang lưu...</span>
                                }
                                else
                                {
                                    <span>Lưu thay đổi</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public bool ShowDialog { get; private set; }
    private UpdateCustomerRequest editModel = new();
    private int _editingId;
    private bool isSaving = false;
    private string? serverError;

    // QUAN TRỌNG: Dùng Func để nhận lại ApiResponse từ cha
    [Parameter] 
    public Func<CustomerResponse, Task<ApiResponse<CustomerResponse>>> OnSave { get; set; }

    public void Show(CustomerResponse customer)
    {
        _editingId = customer.Id;
        editModel = new UpdateCustomerRequest
        {
            Name = customer.Name,
            Phone = customer.Phone,
            Email = customer.Email,
            Address = customer.Address
        };
        serverError = null;
        ShowDialog = true;
        isSaving = false;
        StateHasChanged();
    }

    public void Close()
    {
        if (!isSaving)
        {
            ShowDialog = false;
            StateHasChanged();
        }
    }

   private async Task HandleValidSubmit()
    {
        isSaving = true;
        serverError = null;
        StateHasChanged();

        var updatedCustomer = new CustomerResponse
        {
            Id = _editingId,
            Name = editModel.Name,
            Phone = editModel.Phone,
            Email = editModel.Email,
            Address = editModel.Address
        };

        // Gọi cha và đợi kết quả
        var result = await OnSave(updatedCustomer);

        if (result.Success)
        {
            ShowDialog = false; 
        }
        else
        {
            serverError = !string.IsNullOrEmpty(result.Message) 
                          ? result.Message 
                          : "Lỗi không xác định từ Server (Message is null)";
        }

        isSaving = false;
        StateHasChanged();
    }
}