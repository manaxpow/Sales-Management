@page "/staff/customers/create"
@* <ProtectedRoute RequiredRoles="staff"/> *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))


@using blazor_web.DTOs.Customer
@inject blazor_web.Services.Customer.ICustomerService CustomerService
@inject NavigationManager NavManager


<h3>Thêm mới Khách hàng</h3>

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="oi oi-warning"></i> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        <EditForm Model="@createRequest" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            
            @* Tên *@
            <div class="mb-3">
                <label class="form-label">Tên <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="createRequest.Name" />
                <ValidationMessage For="@(() => createRequest.Name)" class="text-danger" />
            </div>

            @* SĐT *@
            <div class="mb-3">
                <label class="form-label">SĐT <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="createRequest.Phone" />
                <ValidationMessage For="@(() => createRequest.Phone)" class="text-danger" />
            </div>

            @* Email *@
            <div class="mb-3">
                <label class="form-label">Email <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="createRequest.Email" />
                <ValidationMessage For="@(() => createRequest.Email)" class="text-danger" />
            </div>

            @* Địa chỉ *@
            <div class="mb-3">
                <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="createRequest.Address" />
                <ValidationMessage For="@(() => createRequest.Address)" class="text-danger" />
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Đang xử lý...</span>
                    }
                    else
                    {
                        <span>Thêm mới</span>
                    }
                </button>
                <a href="/staff/customers" class="btn btn-secondary ms-2">Quay lại</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CreateCustomerRequest createRequest = new();
    
    // Biến trạng thái
    private string? errorMessage;
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;
            errorMessage = null; 

            // Gọi API thông qua Service
            var response = await CustomerService.CreateCustomerAsync(createRequest);

            if (response.Success)
            {
                // Thành công -> Điều hướng về danh sách
                NavManager.NavigateTo("/staff/customers");
            }
            else
            {
                // Thất bại -> Hiển thị lỗi từ Backend (ví dụ: Email trùng, SĐT sai...)
                errorMessage = response.Message ?? "Có lỗi xảy ra khi tạo khách hàng.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi hệ thống: {ex.Message}";
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            isSubmitting = false;
        }
    }
}