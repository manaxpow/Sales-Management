@page "/staff/customers"
@using blazor_web.DTOs.Customer
@using blazor_web.Models
@* QUAN TRỌNG: Dùng đường dẫn đầy đủ để tránh xung đột *@
@inject blazor_web.Services.Customer.ICustomerService CustomerService
@* <ProtectedRoute RequiredRoles="staff"/> *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
<h3>Quản lý Customer (Staff)</h3>

<div class="d-flex justify-content-between mb-3 align-items-center">
    @* Ô tìm kiếm có Debounce (gõ xong mới tìm) *@
    <div class="input-group w-50">
        <input type="text" class="form-control" placeholder="Tìm theo tên, email..."
               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
        <span class="input-group-text"><i class="oi oi-magnifying-glass"></i></span>
    </div>

    <a href="/staff/customers/create" class="btn btn-primary">
        <i class="oi oi-plus"></i> Thêm mới
    </a>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Address</th>
                <th>Created At</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (customers != null && customers.Any())
            {
                @foreach (var item in customers)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="fw-bold text-success">@item.Name</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>@item.Address</td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => OpenEditDialog(item)">
                                Sửa
                            </button>
                            @* <button class="btn btn-sm btn-danger" @onclick="() => OpenDeleteDialog(item)">
                                Xóa
                            </button> *@
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-3">
                        Không tìm thấy dữ liệu phù hợp
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Phân trang *@
    <div class="d-flex justify-content-between align-items-center">
        <span>Hiển thị trang @currentPage / @totalPages (Tổng: @totalRecords)</span>
        <nav>
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Trước</button>
                </li>
                <li class="page-item active">
                    <span class="page-link">@currentPage</span>
                </li>
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Sau</button>
                </li>
            </ul>
        </nav>
    </div>
}

@* Dialog Components *@
<EditCustomerDialog @ref="editDialog" OnSave="SaveCustomerAsync" />
<DeleteConfirmationDialog @ref="deleteDialog" OnConfirm="DeleteCustomerAsync" />

@code {
    // Sử dụng DTO CustomerResponse thay vì Model Customer cũ
    private List<CustomerResponse> customers = new();
    private bool isLoading = true;
    
    // Biến cho tìm kiếm và phân trang
    private string searchTerm = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalRecords = 0;
    
    // Timer để giảm số lần gọi API khi gõ phím
    private System.Timers.Timer? _debounceTimer;

    // Component References
    private EditCustomerDialog editDialog = default!;
    private DeleteConfirmationDialog deleteDialog = default!;

    protected override async Task OnInitializedAsync()
    {
        // Cấu hình Timer: đợi 500ms sau khi ngừng gõ mới gọi API
        _debounceTimer = new System.Timers.Timer(500);
        _debounceTimer.Elapsed += async (sender, e) => await InvokeAsync(async () => await LoadData());
        _debounceTimer.AutoReset = false;

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new GetCustomerRequest
            {
                Page = currentPage,
                Limit = pageSize,
                Search = searchTerm
            };

            // Gọi API qua Service
            var response = await CustomerService.GetCustomerAsync(request);

            if (response.Success && response.Data != null)
            {
                customers = response.Data.Customers;
                totalRecords = response.Data.Total;
                totalPages = response.Data.TotalPage;
                currentPage = response.Data.CurrentPage;
            }
            else
            {
                customers = new List<CustomerResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // Xử lý tìm kiếm
    private void HandleSearch()
    {
        currentPage = 1; // Reset về trang 1 khi tìm kiếm mới
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    // Xử lý chuyển trang
    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > totalPages) return;
        currentPage = newPage;
        await LoadData();
    }

    // --- LOGIC XÓA ---
    private void OpenDeleteDialog(CustomerResponse customer)
    {
        deleteDialog.Show(customer.Id, customer.Name);
    }

    private async Task DeleteCustomerAsync(int id)
    {
        var result = await CustomerService.DeleteCustomerAsync(id);
        if (result.Success)
        {
            await LoadData(); // Reload lại danh sách sau khi xóa
        }
        else
        {
            // Có thể thêm Toast hiển thị lỗi ở đây
            Console.WriteLine($"Delete failed: {result.Message}");
        }
    }

    // --- LOGIC SỬA ---
    private void OpenEditDialog(CustomerResponse customer)
    {
        editDialog.Show(customer);
    }

    // Hàm Save trả về ApiResponse để Dialog biết có lỗi hay không
    private async Task<ApiResponse<CustomerResponse>> SaveCustomerAsync(CustomerResponse updatedData)
    {
        // Map từ Response sang Request DTO
        var request = new UpdateCustomerRequest
        {
            Name = updatedData.Name,
            Phone = updatedData.Phone,
            Email = updatedData.Email,
            Address = updatedData.Address
        };

        var result = await CustomerService.UpdateCustomerAsync(updatedData.Id, request);

        if (result.Success)
        {
            await LoadData(); // Reload lại danh sách nếu thành công
        }

        return result; // Trả kết quả về cho Dialog
    }
    
    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}