@using blazor_web.Models

@if (ShowDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 9999;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-eye me-2"></i>
                        Product Details
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <h4 class="fw-bold mb-3">@product.ProductName</h4>

                    <div class="row g-3">

                        <div class="col-12">
                            <label class="text-muted">Product ID</label>
                            <div class="fw-semibold">Product-@product.ProductId</div>
                        </div>

                        <div class="col-12">
                            <label class="text-muted">Barcode</label>
                            <div class="fw-semibold">@product.Barcode</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted">Category</label>
                            <div class="fw-semibold">@product.CategoryName</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted">Supplier</label>
                            <div class="fw-semibold">@product.SupplierName</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted">Price</label>
                            <div class="fw-semibold">@PriceHelper.FormatPrice(product.Price)</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted">Unit</label>
                            <div class="fw-semibold">@product.Unit</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted">Quantity</label>
                            <div class="fw-semibold">@product.Quantity</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted">Status</label>
                            <div class="mt-1">
                                <span class="@GetStatusClass((int)product.Status)">
                                    @GetStatusText((int)product.Status)
                                </span>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="text-muted">Product Image</label>
                            <div class="mt-2">
                                <img src="http://localhost:8081/@product.ImageProduct" alt="Product Image"
                                    class="img-fluid rounded border" style="max-height: 200px;">
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
}

@code {
    public bool ShowDialog { get; set; }
    public ProductResponse product = new();

    public async Task Show(ProductResponse res)
    {
        if (res != null)
        {
            product = res;
        }

        ShowDialog = true;
        StateHasChanged();
    }

    public void Close()
    {
        ShowDialog = false;
        StateHasChanged();
    }

    private string GetStatusClass(int status)
    {
        return status == 1
        ? "badge bg-success"
        : "badge bg-danger";
    }

    private string GetStatusText(int status)
    {
        return status == 1 ? "Active" : "Inactive";
    }
}