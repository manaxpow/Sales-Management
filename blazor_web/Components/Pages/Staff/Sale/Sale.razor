    private void AddToCart(ProductResponse p)
    {
        if (p.Quantity <= 0)
        {
            Toast($"{p.ProductName} đã hết hàng!", "danger");
            return;
        }

        var item = cartItems.FirstOrDefault(x => x.Id == p.ProductId);
        if (item == null)
        {
            cartItems.Add(new CartItem { Id = p.ProductId, Name = p.ProductName, Price = p.Price, Quantity = 1, Unit = p.Unit });
        }
        else
        {
            if (item.Quantity >= p.Quantity)
            {
                Toast($"Chỉ còn {p.Quantity} {p.Unit}!", "warning");
                return;
            }
            item.Quantity++;
        }

        Toast($"Đã thêm {p.ProductName}", "success");
        StateHasChanged(); // BẮT BUỘC
    }

    private void UpdateQty(int id, int delta)
    {
        var item = cartItems.FirstOrDefault(x => x.Id == id);
        var product = allProducts.FirstOrDefault(p => p.ProductId == id);
        if (item == null || product == null) return;

        var newQty = item.Quantity + delta;
        if (newQty > product.Quantity)
        {
            Toast($"Chỉ còn {product.Quantity}!", "warning");
            return;
        }
        if (newQty <= 0)
            cartItems.Remove(item);
        else
            item.Quantity = newQty;

        StateHasChanged(); // BẮT BUỘC
    }

    private void RemoveItem(int id)
    {
        cartItems.RemoveAll(x => x.Id == id);
