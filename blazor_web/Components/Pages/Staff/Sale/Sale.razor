    private decimal CalculateDiscount()
    {
        if (selectedPromotion == null || cartTotal < (decimal)selectedPromotion.MinOrderAmount) return 0;
        return selectedPromotion.DiscountType == 1
        ? cartTotal * (decimal)selectedPromotion.DiscountValue / 100
        : (decimal)selectedPromotion.DiscountValue;
    }

