@page "/cart"

@rendermode InteractiveServer

@using blazor_web.Models
@using blazor_web.Services.Cart

@inject ICartService CartService
@inject blazor_web.Services.Orders.IOrderService OrderService
@inject blazor_web.Services.Storage.ILocalStorageService LocalStorageService
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Shopping Cart</PageTitle>

<!-- Page Header -->
<div class="bg-gradient-to-r from-green-600 to-green-800 text-white py-8 px-4 rounded-lg mb-8 shadow-xl">
    <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold mb-2">Shopping Cart</h1>
                <p class="text-green-100">Review your selected items and proceed to checkout</p>
            </div>
            <div class="flex items-center space-x-2">
                <svg class="w-8 h-8 text-green-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span class="text-xl font-semibold">@cartItems.Count Items</span>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cart Items Section -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow-md">
                <!-- Cart Header -->
                <div class="border-b border-gray-200 px-6 py-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-gray-800">Cart Items</h2>
                        <button @onclick="ClearCartAsync" class="text-sm text-red-600 hover:text-red-700 font-medium transition-colors duration-200">
                            Clear Cart
                        </button>
                    </div>
                </div>

                <!-- Cart Items List -->
                <div class="divide-y divide-gray-200">
                    @if (_isLoading)
                    {
                        <div class="p-6 text-center text-gray-500 text-sm">
                            Loading cart...
                        </div>
                    }
                    else if (cartItems.Count > 0)
                    {
                        @foreach (var item in cartItems)
                        {
                            <div class="p-6 hover:bg-gray-50 transition-colors duration-200">
                                <div class="flex items-center space-x-4">
                                    <!-- Product Image -->
                                    <div class="flex-shrink-0 w-20 h-20 bg-gray-100 rounded-lg overflow-hidden">
                                        <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=100&h=100&fit=crop"
                                             alt="@item.Product.ProductName"
                                             class="w-full h-full object-cover" />
                                    </div>

                                    <!-- Product Details -->
                                    <div class="flex-1 min-w-0">
                                        <h3 class="text-lg font-medium text-gray-900 truncate">@item.Product.ProductName</h3>
                                        <p class="text-sm text-gray-500">ID: @item.Product.ProductId | Category: @item.Product.CategoryId</p>
                                        @if (!string.IsNullOrEmpty(item.Product.Barcode))
                                        {
                                            <p class="text-xs text-gray-400">Barcode: @item.Product.Barcode</p>
                                        }
                                    </div>

                                    <!-- Quantity Controls -->
                                    <div class="flex items-center space-x-2">
                                        <button @onclick="() => DecreaseQuantityAsync(item)" class="w-8 h-8 rounded-full bg-gray-200 hover:bg-gray-300 text-gray-700 flex items-center justify-center transition-all duration-200">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                                            </svg>
                                        </button>
                                        <span class="w-12 text-center font-semibold text-gray-900">@item.Quantity</span>
                                        <button @onclick="() => IncreaseQuantityAsync(item)" class="w-8 h-8 rounded-full bg-gray-200 hover:bg-gray-300 text-gray-700 flex items-center justify-center transition-all duration-200">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                            </svg>
                                        </button>
                                    </div>

                                    <!-- Price and Remove -->
                                    <div class="flex flex-col items-end space-y-2">
                                        <div class="text-right">
                                            <p class="text-lg font-bold text-gray-900">$@(item.Product.Price * item.Quantity)</p>
                                            <p class="text-sm text-gray-500">$@item.Product.Price.ToString("F2") each</p>
                                        </div>
                                        <button @onclick="() => RemoveItemAsync(item)" class="text-red-600 hover:text-red-700 transition-colors duration-200">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Empty Cart State -->
                        <div class="p-12 text-center">
                            <svg class="mx-auto h-16 w-16 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                            <h3 class="text-lg font-medium text-gray-900 mb-2">Your cart is empty</h3>
                            <p class="text-gray-500 mb-6">Looks like you haven't added any products to your cart yet.</p>
                            <a href="/products" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-all duration-200 transform hover:scale-105">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                                </svg>
                                Continue Shopping
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Continue Shopping Button -->
            @if (cartItems.Count > 0)
            {
                <div class="mt-6">
                    <a href="/products" class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium transition-colors duration-200">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Continue Shopping
                    </a>
                </div>
            }
        </div>

        <!-- Order Summary Section -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow-md p-6 sticky top-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Order Summary</h2>
                
                <!-- Summary Details -->
                <div class="space-y-3 mb-6">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">Subtotal (@totalItems items)</span>
                        <span class="font-medium text-gray-900">$@subtotal.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">Shipping</span>
                        <span class="font-medium text-gray-900">$@shipping.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">Tax (10%)</span>
                        <span class="font-medium text-gray-900">$@tax.ToString("F2")</span>
                    </div>
                    @if (discount > 0)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-green-600">Discount</span>
                            <span class="font-medium text-green-600">-$@discount.ToString("F2")</span>
                        </div>
                    }
                    <div class="border-t pt-3">
                        <div class="flex justify-between">
                            <span class="text-lg font-bold text-gray-900">Total</span>
                            <span class="text-lg font-bold text-blue-600">$@total.ToString("F2")</span>
                        </div>
                    </div>
                </div>

                <!-- Promo Code -->
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Promo Code</label>
                    <div class="flex space-x-2">
                        <input type="text"
                               @bind="promoCode"
                               @bind:event="oninput"
                               placeholder="Enter promo code"
                               class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" />
                        <button class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium rounded-lg transition-all duration-200 text-sm"
                                @onclick="ApplyPromotionAsync"
                                disabled="@_isApplyingPromo">
                            @if (_isApplyingPromo)
                            {
                                <span>Applying...</span>
                            }
                            else
                            {
                                <span>Apply</span>
                            }
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(_promoMessage))
                    {
                        <div class="mt-2 text-sm @( _promoError ? "text-red-600" : "text-green-600")">
                            @_promoMessage
                        </div>
                    }
                </div>

                <!-- Checkout Button -->
                <button class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-lg transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled="@(_isCheckingOut || cartItems.Count == 0)" @onclick="CheckoutAsync">
                    <div class="flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                        Proceed to Checkout
                    </div>
                </button>
                @if (!string.IsNullOrEmpty(_checkoutMessage))
                {
                    <div class="mt-4 text-sm @( _checkoutError ? "text-red-600" : "text-green-600")">
                        @_checkoutMessage
                    </div>
                }
                <!-- Security Badge -->
                <div class="mt-4 flex items-center justify-center text-xs text-gray-500">
                    <svg class="w-4 h-4 mr-1 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    Secure Checkout
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Cart items with quantity
    private List<CartItem> cartItems = new();
    private bool _isLoading = true;
    private bool _isCheckingOut = false;
    private string? _checkoutMessage;
    private bool _checkoutError = false;

    private string? promoCode;
    private int paymentMethod = 1;

    private bool _isApplyingPromo = false;
    private string? _promoMessage;
    private bool _promoError = false;
    
    // Summary calculations
    private decimal subtotal = 0;
    private decimal shipping = 9.99m;
    private decimal tax = 0;
    private decimal discount = 0;
    private decimal total = 0;
    private int totalItems = 0;

    // public class CartItem
    // {
    //     public blazor_web.Models.Product Product { get; set; } = new();
    //     public int Quantity { get; set; } = 1;
    // }

    // protected override async Task OnInitializedAsync()
    // {
    //    cartItems = await CartService.GetCartAsync();
    //    CalculateTotals();
    // }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isLoading = true;
            Console.WriteLine("[Cart] OnAfterRenderAsync firstRender = true, loading cart...");
        
            cartItems = await CartService.GetCartAsync();
        
            Console.WriteLine($"[Cart] Loaded {cartItems.Count} items from cart");
        
            CalculateTotals();
        
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void GenerateFakeCartData()
    {
        // Create fake products for cart
        var products = new List<blazor_web.Models.Product>
        {
            new blazor_web.Models.Product
            {
                ProductId = 1,
                ProductName = "Laptop Pro 15",
                CategoryId = 1,
                SupplierId = 1,
                Barcode = "1234567890123",
                Price = 899.99m,
                Unit = "pcs",
                CreatedAt = DateTime.Now.AddDays(-30)
            },
            new blazor_web.Models.Product
            {
                ProductId = 2,
                ProductName = "Wireless Mouse",
                CategoryId = 1,
                SupplierId = 2,
                Barcode = "2345678901234",
                Price = 29.99m,
                Unit = "pcs",
                CreatedAt = DateTime.Now.AddDays(-15)
            },
            new blazor_web.Models.Product
            {
                ProductId = 3,
                ProductName = "Mechanical Keyboard",
                CategoryId = 1,
                SupplierId = 1,
                Barcode = "3456789012345",
                Price = 149.99m,
                Unit = "pcs",
                CreatedAt = DateTime.Now.AddDays(-7)
            },
            new blazor_web.Models.Product
            {
                ProductId = 4,
                ProductName = "USB-C Hub",
                CategoryId = 1,
                SupplierId = 3,
                Barcode = "4567890123456",
                Price = 49.99m,
                Unit = "pcs",
                CreatedAt = DateTime.Now.AddDays(-20)
            },
            new blazor_web.Models.Product
            {
                ProductId = 5,
                ProductName = "4K Monitor",
                CategoryId = 1,
                SupplierId = 1,
                Barcode = "5678901234567",
                Price = 449.99m,
                Unit = "pcs",
                CreatedAt = DateTime.Now.AddDays(-10)
            }
        };

        // Add some items to cart with different quantities
        cartItems = new List<CartItem>
        {
            new CartItem { Product = products[0], Quantity = 1 },
            new CartItem { Product = products[1], Quantity = 2 },
            new CartItem { Product = products[2], Quantity = 1 },
            new CartItem { Product = products[3], Quantity = 3 }
        };
    }

    private async Task IncreaseQuantityAsync(CartItem item)
    {
        item.Quantity++;
        CalculateTotals();
        await CartService.UpdateQuantityAsync(item.Product.ProductId, item.Quantity);
    }

    private async Task DecreaseQuantityAsync(CartItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity--;
            await CartService.UpdateQuantityAsync(item.Product.ProductId, item.Quantity);
        }
        else
        {
            cartItems.Remove(item);
            await CartService.RemoveItemAsync(item.Product.ProductId);
        }

        CalculateTotals();
    }

    private async Task RemoveItemAsync(CartItem item)
    {
        cartItems.Remove(item);
        await CartService.RemoveItemAsync(item.Product.ProductId);
        CalculateTotals();
    }

    private async Task ClearCartAsync()
    {
        cartItems.Clear();
        await CartService.ClearCartAsync();
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        subtotal   = cartItems.Sum(item => item.Product.Price * item.Quantity);
        totalItems = cartItems.Sum(item => item.Quantity);
        tax        = subtotal * 0.1m; // 10% tax

        if (discount > subtotal)
        {
            discount = subtotal;
        }

        total = subtotal + shipping + tax - discount;
    }

    private async Task CheckoutAsync()
    {
        if (cartItems.Count == 0) return;

        _isCheckingOut = true;
        _checkoutMessage = null;
        _checkoutError = false;

        try
        {
            // 1. Lấy thông tin đăng nhập từ localStorage
            var loginInfo = await LocalStorageService.GetLoginInfoAsync();
            if (loginInfo == null || loginInfo.User == null)
            {
                _checkoutMessage = "Bạn cần đăng nhập trước khi thanh toán.";
                _checkoutError = true;
                return;
            }

            var userId = loginInfo.User.Id;
            int customerId;

            if (loginInfo.Customer != null)
            {
                customerId = loginInfo.Customer.Id;
            }
            else
            {
                _checkoutMessage = "Không tìm thấy thông tin khách hàng. Vui lòng cập nhật hồ sơ hoặc chọn khách hàng.";
                _checkoutError = true;
                return;
            }

            // 2. Map cart -> Items
            var items = cartItems.Select(item => new blazor_web.Dtos.Orders.CreateOrderItemDto
            {
                Productid = item.Product.ProductId,
                Price = item.Product.Price,
                Quantity = item.Quantity
            }).ToList();

            if (!items.Any())
            {
                _checkoutMessage = "Giỏ hàng trống.";
                _checkoutError = true;
                return;
            }

            // 3. Build request CreateOrderWithItemsRequest
            var request = new blazor_web.Dtos.Orders.CreateOrderWithItemsRequest
            {
                Customerid = customerId,
                Userid = userId,
                Status = 1,
                PromotionCode = string.IsNullOrWhiteSpace(promoCode) ? null : promoCode.Trim(),
                Paymentmethod = paymentMethod, // 1 hoặc 2
                Items = items
            };

            // 4. Gọi API
            var apiResponse = await OrderService.CreateWithItemsAsync(request);

            if (apiResponse.Success && apiResponse.Data != null)
            {
                // 5. Clear cart sau khi thanh toán thành công
                await CartService.ClearCartAsync();
                cartItems.Clear();
                CalculateTotals();

                var orderId = apiResponse.Data.Id;
                _checkoutMessage = $"Đặt hàng thành công. Mã đơn: {orderId}";
                _checkoutError = false;

                // Nếu muốn, điều hướng tới trang chi tiết:
                // Navigation.NavigateTo($"/orders/{orderId}");
            }
            else
            {
                _checkoutMessage = apiResponse.Message ?? "Thanh toán thất bại.";
                _checkoutError = true;
            }
        }
        catch (Exception ex)
        {
            _checkoutMessage = "Có lỗi xảy ra khi thanh toán: " + ex.Message;
            _checkoutError = true;
            Console.WriteLine($"[Cart] Checkout error: {ex}");
        }
        finally
        {
            _isCheckingOut = false;
            StateHasChanged();
        }
    }

    private async Task ApplyPromotionAsync()
    {
        _promoMessage = null;
        _promoError   = false;

        if (string.IsNullOrWhiteSpace(promoCode))
        {
            _promoMessage = "Vui lòng nhập mã khuyến mãi.";
            _promoError   = true;
            return;
        }

        if (subtotal <= 0)
        {
            _promoMessage = "Giỏ hàng trống, không thể áp dụng khuyến mãi.";
            _promoError   = true;
            return;
        }

        _isApplyingPromo = true;

        try
        {
            var code = promoCode.Trim().ToUpper();

            // BaseAddress = http://localhost:8081/api/
            // → Endpoint đầy đủ: GET /api/promotion/by-code/{code}
            var apiResponse =
                await Http.GetFromJsonAsync<ApiResponse<PromotionResponse>>(
                    $"promotion/by-code/{code}"
                );

            if (apiResponse == null || !apiResponse.Success || apiResponse.Data == null)
            {
                _promoMessage = apiResponse?.Message ?? "Không tìm thấy mã khuyến mãi.";
                _promoError   = true;
                discount      = 0;
                CalculateTotals();
                return;
            }

            var promo = apiResponse.Data;
            var now   = DateTime.Now;

            // Các rule giống BE
            if (promo.Status != 1)
            {
                _promoMessage = "Khuyến mãi không hoạt động.";
                _promoError   = true;
                discount      = 0;
                CalculateTotals();
                return;
            }

            if (promo.StartDate > now || promo.EndDate < now)
            {
                _promoMessage = "Khuyến mãi đã hết hạn hoặc chưa bắt đầu.";
                _promoError   = true;
                discount      = 0;
                CalculateTotals();
                return;
            }

            if (promo.Usagelimit > 0 && promo.Usedcount >= promo.Usagelimit)
            {
                _promoMessage = "Mã khuyến mãi đã dùng hết lượt.";
                _promoError   = true;
                discount      = 0;
                CalculateTotals();
                return;
            }

            if (promo.MinOrderAmount > subtotal)
            {
                _promoMessage = $"Đơn hàng phải từ {promo.MinOrderAmount:C} mới áp dụng được mã này.";
                _promoError   = true;
                discount      = 0;
                CalculateTotals();
                return;
            }

            // Tính giảm giá
            decimal newDiscount = promo.DiscountType == 1
                ? subtotal * promo.DiscountValue / 100m
                : promo.DiscountValue;

            if (newDiscount > subtotal)
                newDiscount = subtotal;

            discount = newDiscount;
            CalculateTotals();

            _promoMessage = $"Áp dụng mã {promo.PromotionCode} thành công. Giảm {discount:C}.";
            _promoError   = false;
        }
        catch (Exception ex)
        {
            _promoMessage = "Có lỗi xảy ra khi áp dụng mã khuyến mãi.";
            _promoError   = true;
            discount      = 0;
            CalculateTotals();
            Console.WriteLine($"[Cart] ApplyPromotionAsync error: {ex}");
        }
        finally
        {
            _isApplyingPromo = false;
            StateHasChanged();
        }
    }
}
