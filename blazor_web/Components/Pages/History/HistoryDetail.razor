@page "/history/{orderId:int}"
@using blazor_web.Models
@using blazor_web.Services.History
@using blazor_web.DTOs.History
@using blazor_web.Services.Storage
@using blazor_web.Services.Orders
@using blazor_web.DTOs.Orders

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHistoryService HistoryService
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject IOrderService OrderService

<PageTitle>Chi tiết đơn hàng #@orderId</PageTitle>

<div class="container mx-auto px-4 py-8">
    @* Header *@
    <div class="mb-6">
        <button class="btn btn-outline-secondary mb-3" @onclick="GoBack">
            <i class="bi bi-arrow-left me-2"></i>Quay lại lịch sử
        </button>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Chi tiết đơn hàng #@orderDetail?.Id</h1>
        <p class="text-gray-600">Xem chi tiết các sản phẩm trong đơn hàng</p>
    </div>

    @* Thông báo *@
    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert @(IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mb-4">
            @if(IsSuccess) { <i class="bi bi-check-circle-fill me-2"></i> } else { <i class="bi bi-exclamation-triangle-fill me-2"></i> }
            @Message
            <button type="button" class="btn-close" @onclick="() => Message = null"></button>
        </div>
    }

    @* Loading hoặc Chi tiết đơn hàng *@
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang tải chi tiết đơn hàng...</p>
        </div>
    }
    else if (orderDetail == null)
    {
        <div class="text-center py-8">
            <i class="bi bi-exclamation-triangle display-4 text-danger"></i>
            <p class="mt-3 text-muted">Không tìm thấy thông tin đơn hàng</p>
        </div>
    }
    else
    {
        <div class="row">
            @* Thông tin đơn hàng *@
            <div class="col-lg-4 mb-4">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h5 class="text-lg font-semibold mb-4">Thông tin đơn hàng</h5>
                    <div class="space-y-3">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Mã đơn hàng:</span>
                            <strong>#@orderDetail.Id</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Ngày đặt:</span>
                            <strong>@orderDetail.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Trạng thái:</span>
                            @{
                                var statusClass = orderDetail.Status switch
                                {
                                    0 => "bg-warning text-dark",
                                    1 => "bg-success text-white",
                                    2 => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };
                                var statusText = orderDetail.Status switch
                                {
                                    0 => "Đang xử lý",
                                    1 => "Đã giao hàng",
                                    2 => "Đã hủy",
                                    _ => "Không xác định"
                                };
                            }
                            <span class="badge @statusClass">@statusText</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Tổng tiền:</span>
                            <strong>@orderDetail.TotalAmount.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Giảm giá:</span>
                            <strong class="text-success">-@orderDetail.DiscountAmount.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-3">
                            <span class="text-lg font-semibold">Thành tiền:</span>
                            <span class="text-lg font-bold text-primary">@orderDetail.FinalAmount.ToString("N0") VNĐ</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Danh sách sản phẩm *@
            <div class="col-lg-8 mb-4">
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="card-header bg-light">
                        <h5 class="text-lg font-semibold mb-0">Sản phẩm trong đơn hàng</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th width="80">Hình ảnh</th>
                                    <th>Sản phẩm</th>
                                    <th width="100">Đơn giá</th>
                                    <th width="80">Số lượng</th>
                                    <th width="120">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in orderDetail.Items)
                                {
                                    <tr>
                                        <td>
                                            <img src="@item.ImageProduct" 
                                                 alt="@item.ProductName" 
                                                 class="img-thumbnail" 
                                                 style="width: 60px; height: 60px; object-fit: cover;"
                                                 onerror="this.src='/images/default-product.png'" />
                                        </td>
                                        <td>
                                            <div>
                                                <strong class="d-block">@item.ProductName</strong>
                                                <small class="text-muted d-block">Barcode: @item.Barcode</small>
                                                <small class="text-muted">Đơn vị: @item.Unit</small>
                                            </div>
                                        </td>
                                        <td>@item.Price.ToString("N0") VNĐ</td>
                                        <td>@item.Quantity @item.Unit</td>
                                        <td><strong>@item.SubTotal.ToString("N0") VNĐ</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    @* Tổng kết sản phẩm *@
                    <div class="card-footer bg-light">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <span class="text-muted">Tổng số lượng sản phẩm: <strong>@orderDetail.Items.Sum(x => x.Quantity)</strong></span>
                            </div>
                            <div class="col-md-6 text-end">
                                <span class="text-muted">Tổng tiền sản phẩm: <strong>@orderDetail.Items.Sum(x => x.SubTotal).ToString("N0") VNĐ</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Thông tin thêm *@
        <div class="row mt-4">
            <div class="col-12">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h5 class="text-lg font-semibold mb-4">Thông tin thêm</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Mã khách hàng:</strong> @orderDetail.Customerid</p>
                            <p class="mb-2"><strong>Mã người đặt:</strong> @orderDetail.Userid</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Số lượng mặt hàng:</strong> @orderDetail.Items.Count</p>
                            <p class="mb-2"><strong>Tổng số lượng:</strong> @orderDetail.Items.Sum(x => x.Quantity)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Nút thao tác *@
        <div class="row mt-4">
            <div class="col-12 text-center">
                <button class="btn btn-primary me-2" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </button>
                @if (orderDetail.Status == 0)
                {
                    <button class="btn btn-danger" @onclick="CancelOrder">
                        <i class="bi bi-x-circle me-2"></i>Hủy đơn hàng
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int orderId { get; set; }

    // Data
    private GetHistoryDetailResponse? orderDetail;
    private bool isLoading = true;
    private int? currentUserId;

    // Notification
    private string? Message;
    private bool IsSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserId();
        if (currentUserId.HasValue)
        {
            await LoadOrderDetail();
        }
        else
        {
            ShowMessage("Vui lòng đăng nhập để xem chi tiết đơn hàng", false);
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadUserId()
    {
        try
        {
            var loginInfo = await LocalStorage.GetLoginInfoAsync();
            currentUserId = loginInfo?.User?.Id;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user ID: {ex.Message}");
        }
    }

    private async Task LoadOrderDetail()
    {
        if (!currentUserId.HasValue) return;

        isLoading = true;
        try
        {
            var request = new GetHistoryDetailRequest
            {
                UserId = currentUserId.Value,
                OrderId = orderId
            };

            var result = await HistoryService.GetOrderHistoryDetailAsync(request);
            if (result.Success && result.Data != null)
            {
                orderDetail = result.Data;
            }
            else
            {
                ShowMessage(result.Message ?? "Lỗi tải chi tiết đơn hàng", false);
                orderDetail = null;
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Lỗi hệ thống: {ex.Message}", false);
            orderDetail = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/history");
    }

    private async Task CancelOrder()
    {
        if (orderDetail == null) return;

        try
        {
            // Create update request with status = 2 (cancelled)
            var updateRequest = new OrderRequest
            {
                Customerid = orderDetail.Customerid,
                Userid = orderDetail.Userid,
                Status = 2, // 2 = Đã hủy
                TotalAmount = orderDetail.TotalAmount,
                DiscountAmount = orderDetail.DiscountAmount,
                OrderDate = orderDetail.OrderDate
            };

            var result = await OrderService.UpdateOrderAsync(orderDetail.Id, updateRequest);
            
            if (result.Success)
            {
                ShowMessage($"Đã hủy đơn hàng #{orderDetail.Id} thành công", true);
                
                // Reload order detail to reflect the status change
                await LoadOrderDetail();
            }
            else
            {
                ShowMessage(result.Message ?? "Không thể hủy đơn hàng. Vui lòng thử lại.", false);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Lỗi hệ thống khi hủy đơn hàng: {ex.Message}", false);
        }
    }

    private void ShowMessage(string msg, bool success)
    {
        Message = msg;
        IsSuccess = success;
        StateHasChanged();
        
        // Auto hide after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            Message = null;
            InvokeAsync(StateHasChanged);
        });
    }
}
