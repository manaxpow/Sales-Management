@page "/history"
@using blazor_web.Models
@using blazor_web.Services.History
@using blazor_web.DTOs.History
@using blazor_web.Services.Storage

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHistoryService HistoryService
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<PageTitle>Lịch sử đơn hàng</PageTitle>

<div class="container mx-auto px-4 py-8">
    @* Header *@
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Lịch sử đơn hàng</h1>
        <p class="text-gray-600">Xem lại các đơn hàng đã đặt của bạn</p>
    </div>

    @* Thông báo *@
    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert @(IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm mb-4">
            @if(IsSuccess) { <i class="bi bi-check-circle-fill me-2"></i> } else { <i class="bi bi-exclamation-triangle-fill me-2"></i> }
            @Message
            <button type="button" class="btn-close" @onclick="() => Message = null"></button>
        </div>
    }

    @* Filter *@
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Trạng thái</label>
                <select class="form-select" @bind="currentStatus">
                    <option value="">Tất cả</option>
                    <option value="1">Đang xử lý</option>
                    <option value="2">Đã xác nhận</option>
                    <option value="3">Đang giao hàng</option>
                    <option value="4">Đã giao hàng</option>
                    <option value="5">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Từ ngày</label>
                <input type="date" class="form-control" @bind="currentDateFrom" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Đến ngày</label>
                <input type="date" class="form-control" @bind="currentDateTo" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="ApplyFilters">
                    <i class="bi bi-search me-2"></i>Tìm kiếm
                </button>
            </div>
        </div>
    </div>

    @* Loading hoặc Bảng *@
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang tải dữ liệu...</p>
        </div>
    }
    else if (!historyItems.Any())
    {
        <div class="text-center py-8">
            <i class="bi bi-clock-history display-4 text-muted"></i>
            <p class="mt-3 text-muted">Không có đơn hàng nào trong lịch sử</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Giảm giá</th>
                            <th>Thành tiền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in historyItems)
                        {
                            <tr>
                                <td><strong>#@order.Id</strong></td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.TotalAmount.ToString("N0") VNĐ</td>
                                <td>@order.DiscountAmount.ToString("N0") VNĐ</td>
                                <td class="text-primary fw-bold">@order.FinalAmount.ToString("N0") VNĐ</td>
                                <td>
                                    @{
                                        var statusClass = order.Status switch
                                        {
                                            0 => "bg-warning text-dark",
                                            1 => "bg-success text-white",
                                            2 => "bg-danger text-white",
                                            _ => "bg-secondary text-white"
                                        };
                                        var statusText = order.Status switch
                                        {
                                            0 => "Đang xử lý",
                                            1 => "Đã giao hàng",
                                            2 => "Đã hủy",
                                            _ => "Không xác định"
                                        };
                                    }
                                    <span class="badge @statusClass">@statusText</span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetail(order.Id)">
                                        <i class="bi bi-eye me-1"></i>Xem chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination *@
            @if (totalCount > pageSize)
            {
                <div class="card-footer bg-light">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <label class="me-2 mb-0">Hiển thị:</label>
                                <select class="form-select form-select-sm" style="width: auto;" value="@pageSize" @onchange="HandlePageSizeChanged">
                                    <option value="5">5</option>
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                </select>
                                <span class="ms-2 text-muted">/ @totalCount bản ghi</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-end">
                                <nav>
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="currentPage == 1">
                                                <i class="bi bi-chevron-left"></i>
                                            </button>
                                        </li>
                                        
                                        @{
                                            int startPage = Math.Max(1, currentPage - 2);
                                            int endPage = Math.Min(totalPages, currentPage + 2);
                                        }
                                        
                                        @if (startPage > 1)
                                        {
                                            <li class="page-item">
                                                <button class="page-link" @onclick="() => GoToPage(1)">1</button>
                                            </li>
                                            @if (startPage > 2)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }
                                        
                                        @for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                            </li>
                                        }
                                        
                                        @if (endPage < totalPages)
                                        {
                                            @if (endPage < totalPages - 1)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                            <li class="page-item">
                                                <button class="page-link" @onclick="() => GoToPage(totalPages)">@totalPages</button>
                                            </li>
                                        }
                                        
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="currentPage == totalPages">
                                                <i class="bi bi-chevron-right"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    // Data
    private List<GetHistoryResponse> historyItems = new();
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;

    // Filter
    private string? currentStatus;
    private DateTime? currentDateFrom;
    private DateTime? currentDateTo;

    // State
    private bool isLoading = true;
    private int? currentUserId;

    // Notification
    private string? Message;
    private bool IsSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserId();
        if (currentUserId.HasValue)
        {
            await LoadHistory();
        }
        else
        {
            ShowMessage("Vui lòng đăng nhập để xem lịch sử đơn hàng", false);
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadUserId()
    {
        try
        {
            var loginInfo = await LocalStorage.GetLoginInfoAsync();
            currentUserId = loginInfo?.User?.Id;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user ID: {ex.Message}");
        }
    }

    private async Task LoadHistory()
    {
        if (!currentUserId.HasValue) return;

        isLoading = true;
        try
        {
            var request = new GetHistoryRequest
            {
                UserId = currentUserId.Value,
                Page = currentPage,
                PageSize = pageSize,
                Status = string.IsNullOrEmpty(currentStatus) ? null : int.Parse(currentStatus),
                DateFrom = currentDateFrom,
                DateTo = currentDateTo
            };

            var result = await HistoryService.GetOrderHistoryAsync(request);
            if (result.Success && result.Data != null)
            {
                historyItems = result.Data.Data.ToList();
                totalCount = result.Data.TotalCount;
                totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
            }
            else
            {
                ShowMessage(result.Message ?? "Lỗi tải lịch sử đơn hàng", false);
                historyItems = new List<GetHistoryResponse>();
                totalCount = 0;
                totalPages = 0;
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Lỗi hệ thống: {ex.Message}", false);
            historyItems = new List<GetHistoryResponse>();
            totalCount = 0;
            totalPages = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1; // Reset to first page when applying filters
        await LoadHistory();
    }

    private async Task HandlePageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPageSize))
        {
            pageSize = newPageSize;
            currentPage = 1; // Reset to first page when changing page size
            await LoadHistory();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages && page != currentPage)
        {
            currentPage = page;
            await LoadHistory();
        }
    }

    private void ViewDetail(int orderId)
    {
        Navigation.NavigateTo($"/history/{orderId}");
    }

    private void ShowMessage(string msg, bool success)
    {
        Message = msg;
        IsSuccess = success;
        StateHasChanged();
        
        // Auto hide after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            Message = null;
            InvokeAsync(StateHasChanged);
        });
    }
}
