@page "/profile"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using blazor_web.DTOs.Customer
@using blazor_web.DTOs.Auth
@using blazor_web.Services.Storage
@using blazor_web.Models
@using blazor_web.Services.Customer

@inject ILocalStorageService LocalStorageService
@inject ICustomerService CustomerService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Hồ sơ cá nhân</PageTitle>

<div class="min-h-screen bg-gray-50 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100 transition-all duration-300 hover:shadow-2xl">

            <div class="relative bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-700 px-8 py-10 overflow-hidden">
                <div class="absolute top-0 right-0 -mr-10 -mt-10 w-40 h-40 rounded-full bg-white/10 blur-3xl"></div>
                <div class="absolute bottom-0 left-0 -ml-10 -mb-10 w-40 h-40 rounded-full bg-white/10 blur-3xl"></div>

                <div class="relative flex items-center space-x-6 z-10">
                    <div class="flex-shrink-0">
                        <div class="w-20 h-20 rounded-full bg-white/20 p-1.5 backdrop-blur-md shadow-inner">
                            <div class="w-full h-full rounded-full bg-white flex items-center justify-center text-3xl font-extrabold text-indigo-600 uppercase shadow-sm">
                                @(GetAvatarInitial())
                            </div>
                        </div>
                    </div>

                    <div class="text-white">
                        <h1 class="text-2xl font-bold tracking-tight">Hồ sơ cá nhân</h1>
                        <p class="text-blue-100 text-sm font-medium opacity-90 mt-1 flex items-center">
                            <i class="fas fa-id-badge mr-2"></i>
                            Xin chào, @(profileModel.Name ?? "Bạn")!
                        </p>
                    </div>
                </div>
            </div>

            <div class="p-8 sm:p-10">
                @if (isLoading)
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 animate-pulse">
                        <div class="h-12 bg-gray-100 rounded-xl w-full"></div>
                        <div class="h-12 bg-gray-100 rounded-xl w-full"></div>
                        <div class="h-12 bg-gray-100 rounded-xl w-full"></div>
                        <div class="md:col-span-2 h-24 bg-gray-100 rounded-xl w-full"></div>
                    </div>
                }
                else
                {
                    <EditForm Model="profileModel" OnValidSubmit="UpdateProfile" class="space-y-6">
                        <DataAnnotationsValidator />
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                            
                            <div class="group">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    Họ và tên <span class="text-red-500">*</span>
                                </label>
                                <div class="relative transition-all duration-200 focus-within:ring-2 focus-within:ring-blue-500/20 rounded-xl">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <InputText @bind-Value="profileModel.Name"
                                        class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-blue-500 transition-colors"
                                        placeholder="Nhập họ và tên của bạn" />
                                </div>
                                <ValidationMessage For="() => profileModel.Name" class="text-red-500 text-xs mt-1.5 ml-1 font-medium" />
                            </div>

                            <div class="group">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    Số điện thoại <span class="text-red-500">*</span>
                                </label>
                                <div class="relative transition-all duration-200 focus-within:ring-2 focus-within:ring-blue-500/20 rounded-xl">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                                        <i class="fas fa-phone"></i>
                                    </div>
                                    <InputText @bind-Value="profileModel.Phone" @oninput="OnPhoneInput"
                                        class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-blue-500 transition-colors"
                                        placeholder="0901234567" />
                                </div>
                                <ValidationMessage For="() => profileModel.Phone" class="text-red-500 text-xs mt-1.5 ml-1 font-medium" />
                            </div>

                            <div class="group">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    Email <span class="text-red-500">*</span>
                                </label>
                                <div class="relative transition-all duration-200 focus-within:ring-2 focus-within:ring-blue-500/20 rounded-xl">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                                        <i class="fas fa-envelope"></i>
                                    </div>
                                    <InputText @bind-Value="profileModel.Email"
                                        class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-blue-500 transition-colors"
                                        placeholder="name@example.com" />
                                </div>
                                <ValidationMessage For="() => profileModel.Email" class="text-red-500 text-xs mt-1.5 ml-1 font-medium" />
                            </div>

                            <div class="md:col-span-2 group">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Địa chỉ</label>
                                <div class="relative transition-all duration-200 focus-within:ring-2 focus-within:ring-blue-500/20 rounded-xl">
                                    <div class="absolute top-3.5 left-4 flex items-start pointer-events-none text-gray-400">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <InputTextArea @bind-Value="profileModel.Address" rows="3"
                                        class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-blue-500 transition-colors resize-none"
                                        placeholder="Nhập địa chỉ nhận hàng" />
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-end space-x-4 pt-8 border-t border-gray-100 mt-4">
                            <button type="button" @onclick="GoToChangePassword"
                                class="px-6 py-2.5 rounded-xl text-sm font-bold text-blue-700 bg-blue-50 border border-blue-300 hover:bg-blue-100 hover:text-blue-900 transition-all duration-200 shadow-sm mr-2">
                                <i class="fas fa-key mr-2"></i>
                                Đổi mật khẩu
                            </button>
                            <button type="button" @onclick="GoHome"
                                class="px-6 py-2.5 rounded-xl text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 hover:text-gray-900 transition-all duration-200 shadow-sm">
                                Hủy bỏ
                            </button>

                            <button type="submit" disabled="@isSubmitting"
                                class="relative flex items-center justify-center space-x-2 px-8 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-bold shadow-lg shadow-blue-200 hover:bg-blue-700 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none">
                                @if (isSubmitting)
                                {
                                    <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    <span>Đang xử lý...</span>
                                }
                                else
                                {
                                    <span>Lưu thay đổi</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>

    @if (showSuccess)
    {
        <div class="fixed top-5 right-5 z-50 animate-[slideInRight_0.4s_ease-out]">
            <div class="bg-white border-l-4 border-green-500 px-6 py-4 rounded-lg shadow-2xl flex items-center space-x-4 max-w-sm">
                <div class="flex-shrink-0 bg-green-100 p-2 rounded-full">
                    <i class="fas fa-check text-green-600 text-lg"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-gray-900">Cập nhật thành công!</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Thông tin hồ sơ đã được lưu lại.</p>
                </div>
                <button @onclick="() => showSuccess = false" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes slideInRight {
        from { opacity: 0; transform: translateX(100%); }
        to { opacity: 1; transform: translateX(0); }
    }
</style>

@code {
    // === LOGIC GIỮ NGUYÊN ===
    public class ProfileViewModel
    {
        [Required(ErrorMessage = "Vui lòng nhập họ và tên.")]
        [RegularExpression(@"^[a-zA-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚĂĐĨŨƠàáâãèéêìíòóôõùúăđĩũơƯĂẠẢẤẦẨẪẬẮẰẲẴẶẸẺẼỀỀỂỄỆỈỊỌỎỐỒỔỖỘỚỜỞỠỢỤỦỨỪỬỮỰỲỴÝỶỸ\s]+$", 
            ErrorMessage = "Họ tên không được chứa số hoặc ký tự đặc biệt.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập số điện thoại.")]
        [RegularExpression(@"^0(3|5|7|8|9)[0-9]{8}$", ErrorMessage = "SĐT không hợp lệ (phải bắt đầu bằng 03,05,07,08,09 và đủ 10 số).")]
        public string Phone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập Email.")]
        [EmailAddress(ErrorMessage = "Địa chỉ Email không đúng định dạng.")]
        public string Email { get; set; } = string.Empty;

        public string? Address { get; set; }
    }

    private LoginResponse? loginInfo;
    private ProfileViewModel profileModel = new();
    
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showSuccess = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                loginInfo = await LocalStorageService.GetLoginInfoAsync();

                if (loginInfo?.User == null || loginInfo.User.Id <= 0)
                {
                    Navigation.NavigateTo("/login", forceLoad: true);
                    return;
                }

                if (loginInfo.Customer != null && loginInfo.Customer.Id > 0)
                {
                    var apiResponse = await CustomerService.GetCustomerAsync(new GetCustomerRequest
                    {
                        Id = loginInfo.Customer.Id,
                        Limit = 1
                    });

                    var customer = apiResponse.Data?.Customers?.FirstOrDefault();
                    if (customer != null)
                    {
                        profileModel.Name = customer.Name;
                        profileModel.Phone = customer.Phone;
                        profileModel.Email = customer.Email;
                        profileModel.Address = customer.Address;
                        
                        loginInfo.Customer.Name = customer.Name;
                    }
                }
                else
                {
                    profileModel.Name = loginInfo.User.FullName;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void OnPhoneInput(ChangeEventArgs e)
    {
        if (e.Value is string value)
        {
            var numbersOnly = new string(value.Where(char.IsDigit).ToArray());
            if (numbersOnly.Length > 10) numbersOnly = numbersOnly[..10];
            profileModel.Phone = numbersOnly;
        }
    }

    private async Task UpdateProfile()
    {
        isSubmitting = true;

        try
        {
            var updateRequest = new UpdateCustomerRequest
            {
                Name = profileModel.Name,
                Phone = profileModel.Phone,
                Email = profileModel.Email,
                Address = profileModel.Address
            };

            var idToUpdate = (loginInfo!.Customer != null && loginInfo.Customer.Id > 0) 
                             ? loginInfo.Customer.Id 
                             : loginInfo.User.Id;

            var result = await CustomerService.UpdateCustomerAsync(idToUpdate, updateRequest);

            if (result.Success)
            {
                if (loginInfo.Customer == null) loginInfo.Customer = new CustomerResponse(); // Đã sửa theo logic bạn cung cấp
                
                loginInfo.Customer.Name = profileModel.Name;
                loginInfo.Customer.Phone = profileModel.Phone;
                
                @* await LocalStorageService.SaveLoginInfoAsync(loginInfo); // Lưu lại local storage *@

                showSuccess = true;
                StateHasChanged();
                await Task.Delay(3000);
                showSuccess = false;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", result.Message ?? "Cập nhật thất bại.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            await JS.InvokeVoidAsync("alert", "Lỗi hệ thống.");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private char GetAvatarInitial()
    {
        if (!string.IsNullOrEmpty(profileModel.Name)) return profileModel.Name[0];
        if (!string.IsNullOrEmpty(loginInfo?.User?.FullName)) return loginInfo.User.FullName[0];
        return 'U';
    }

    private void GoHome() => Navigation.NavigateTo("/");
    private void GoToChangePassword() => Navigation.NavigateTo("/customer/profile/change-password");
}
