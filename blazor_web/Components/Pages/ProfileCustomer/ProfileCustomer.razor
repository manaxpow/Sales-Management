@page "/profile"
@rendermode InteractiveServer

@using blazor_web.DTOs.Customer
@using blazor_web.DTOs.Auth
@using blazor_web.Services.Storage
@using blazor_web.Models
@using blazor_web.Services.Customer

@inject ILocalStorageService LocalStorageService
@inject ICustomerService CustomerService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Hồ sơ cá nhân</PageTitle>

<div class="min-h-screen bg-gray-50/50 py-8 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">

            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-8 py-6">
                <div class="flex items-center space-x-5">
                    <div class="flex-shrink-0">
                        <div class="w-16 h-16 rounded-full bg-white/20 p-1 backdrop-blur-sm">
                            <div
                                class="w-full h-full rounded-full bg-white flex items-center justify-center text-2xl font-bold text-indigo-600 uppercase">
                                @(loginInfo?.Customer?.Name?.FirstOrDefault() ?? 'U')
                            </div>
                        </div>
                    </div>

                    <div class="text-white">
                        <h1 class="text-xl font-bold">Hồ sơ cá nhân</h1>
                        <p class="text-blue-100 text-sm opacity-90 mt-0.5">Xin chào, @(loginInfo?.Customer?.Name ??
                                                        "Khách")!</p>
                    </div>
                </div>
            </div>

            <div class="p-8">
                @if (isLoading)
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-pulse">
                        <div class="h-10 bg-gray-100 rounded-lg w-full"></div>
                        <div class="h-10 bg-gray-100 rounded-lg w-full"></div>
                        <div class="h-10 bg-gray-100 rounded-lg w-full"></div>
                        <div class="md:col-span-2 h-20 bg-gray-100 rounded-lg w-full"></div>
                    </div>
                }
                else
                {
                    <EditForm Model="updateRequest" OnValidSubmit="UpdateProfile">
                        <DataAnnotationsValidator />
                        <ValidationSummary
                            class="text-red-600 text-xs bg-red-50 p-3 rounded-lg border border-red-100 mb-5" />

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                            <div class="group">
                                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5 ml-1">
                                    Họ và tên <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <div
                                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                                        <i class="fas fa-user text-sm"></i>
                                    </div>
                                    <InputText @bind-Value="updateRequest.Name"
                                        class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                        placeholder="Nhập họ tên" />
                                </div>
                                <ValidationMessage For="() => updateRequest.Name" class="text-red-500 text-xs mt-1 ml-1" />
                                @if (nameError != null)
                                {
                                    <div class="text-red-500 text-xs mt-1 ml-1">@nameError</div>
                                }
                            </div>

                            <div class="group">
                                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5 ml-1">
                                    Số điện thoại <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <div
                                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                                        <i class="fas fa-phone text-sm"></i>
                                    </div>
                                    <InputText @bind-Value="updateRequest.Phone" @oninput="OnPhoneInput"
                                        class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                        placeholder="Ví dụ: 0901234567" />
                                </div>
                                <ValidationMessage For="() => updateRequest.Phone" class="text-red-500 text-xs mt-1 ml-1" />
                                @if (phoneError != null)
                                {
                                    <div class="text-red-500 text-xs mt-1 ml-1">@phoneError</div>
                                }
                            </div>

                            <!-- Các trường khác giữ nguyên -->
                            <div class="group">
                                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5 ml-1">
                                    Email <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <div
                                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                                        <i class="fas fa-envelope text-sm"></i>
                                    </div>
                                    <InputText @bind-Value="updateRequest.Email"
                                        class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                        placeholder="email@example.com" />
                                </div>
                                <ValidationMessage For="() => updateRequest.Email" class="text-red-500 text-xs mt-1 ml-1" />
                            </div>

                            <div class="md:col-span-2 group">
                                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5 ml-1">Địa
                                    chỉ</label>
                                <div class="relative">
                                    <div class="absolute top-3 left-3 flex items-start pointer-events-none text-gray-400">
                                        <i class="fas fa-map-marker-alt text-sm"></i>
                                    </div>
                                    <InputTextArea @bind-Value="updateRequest.Address" rows="2"
                                        class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all resize-none"
                                        placeholder="Nhập địa chỉ" />
                                </div>
                            </div>
                        </div>

                        <!-- Nút lưu và hủy giữ nguyên -->
                        <div class="flex items-center justify-end space-x-3 mt-8 pt-5 border-t border-gray-100">
                            <button type="button" @onclick="GoHome"
                                class="px-5 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100 transition-colors">
                                Hủy
                            </button>

                            <button type="submit" disabled="@(isSubmitting || !IsValid())"
                                class="flex items-center space-x-2 px-6 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium shadow-md hover:bg-blue-700 hover:shadow-lg transition-all disabled:opacity-70 disabled:shadow-none">
                                @if (isSubmitting)
                                {
                                    <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none"
                                        viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                            stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor"
                                            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                                        </path>
                                    </svg>
                                }
                                <span>Lưu thay đổi</span>
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>

    @if (showSuccess)
    {
        <div class="fixed top-20 right-5 z-50 animate-[slideIn_0.3s_ease-out]">
            <div class="bg-white border-l-4 border-green-500 px-4 py-3 rounded shadow-lg flex items-center space-x-3">
                <i class="fas fa-check-circle text-green-500 text-lg"></i>
                <div>
                    <p class="text-sm font-bold text-gray-800">Thành công</p>
                    <p class="text-xs text-gray-500">Đã cập nhật hồ sơ.</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private LoginResponse? loginInfo;
    private UpdateCustomerRequest updateRequest = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showSuccess = false;

    private string? nameError;
    private string? phoneError;

    private bool IsValid()
    {
        ValidateName();
        ValidatePhone();
        return string.IsNullOrEmpty(nameError) && string.IsNullOrEmpty(phoneError);
    }

    private void ValidateName()
    {
        if (string.IsNullOrWhiteSpace(updateRequest.Name))
        {
            nameError = "Họ và tên là bắt buộc.";
        }
        else if (System.Text.RegularExpressions.Regex.IsMatch(updateRequest.Name, @"\d"))
        {
            nameError = "Họ và tên không được chứa số.";
        }
        else if (!System.Text.RegularExpressions.Regex.IsMatch(updateRequest.Name,
        @"^[a-zA-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚĂĐĨŨƠàáâãèéêìíòóôõùúăđĩũơƯĂẠẢẤẦẨẪẬẮẰẲẴẶẸẺẼỀỀỂỄỆỈỊỌỎỐỒỔỖỘỚỜỞỠỢỤỦỨỪỬỮỰỲỴÝỶỸ\s-]+$"))
        {
            nameError = "Họ và tên chỉ được chứa chữ cái và dấu tiếng Việt.";
        }
        else
        {
            nameError = null;
        }
    }

    private void ValidatePhone()
    {
        if (string.IsNullOrWhiteSpace(updateRequest.Phone))
        {
            phoneError = "Số điện thoại là bắt buộc.";
        }
        else if (!System.Text.RegularExpressions.Regex.IsMatch(updateRequest.Phone, @"^0(3|5|7|8|9)[0-9]{8}$"))
        {
            phoneError = "Số điện thoại phải có 10 số và bắt đầu bằng 03, 05, 07, 08 hoặc 09.";
        }
        else
        {
            phoneError = null;
        }
    }
    private void OnPhoneInput(ChangeEventArgs e)
    {
        if (e.Value is string value)
        {
            var numbersOnly = string.Concat(value.Where(char.IsDigit));
            if (numbersOnly.Length > 10)
                numbersOnly = numbersOnly[..10];
            updateRequest.Phone = numbersOnly;
            ValidatePhone();
            StateHasChanged();
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                loginInfo = await LocalStorageService.GetLoginInfoAsync();

                if (loginInfo?.Customer == null)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }

                var myId = loginInfo.Customer.Id;

                var apiResponse = await CustomerService.GetCustomerAsync(new GetCustomerRequest
                {
                    Id = myId,
                    Limit = 1
                });


                var customer = apiResponse.Data?.Customers?.FirstOrDefault(x => x.Id == myId);

                if (customer != null)
                {
                    updateRequest.Name = customer.Name;
                    updateRequest.Phone = customer.Phone;
                    updateRequest.Email = customer.Email;
                    updateRequest.Address = customer.Address;
                }

                isLoading = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task UpdateProfile()
    {
        if (!IsValid())
        {
            return;
        }

        isSubmitting = true;

        var userId = loginInfo.Customer.Id;
        var result = await CustomerService.UpdateCustomerAsync(userId, updateRequest);

        if (result.Success)
        {
            showSuccess = true;
            loginInfo = await LocalStorageService.GetLoginInfoAsync();
            StateHasChanged();
            await Task.Delay(3000);
            showSuccess = false;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", result.Message ?? "Cập nhật thất bại!");
        }

        isSubmitting = false;
        StateHasChanged();
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}