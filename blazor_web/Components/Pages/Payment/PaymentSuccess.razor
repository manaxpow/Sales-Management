@page "/payment-success/{orderId:int}"
@using blazor_web.DTOs.Auth
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject Services.Orders.IOrderService OrderService
@inject Services.Storage.ILocalStorageService LocalStorage
<PageTitle>Payment Successful - ShopMart</PageTitle>

<!-- Loading State -->
@if (isLoading)
{
    <section class="bg-gradient-to-r from-blue-500 to-blue-600 text-white py-20">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <div class="animate-spin rounded-full h-16 w-16 border-b-4 border-white mx-auto mb-6"></div>
                <h1 class="text-3xl md:text-4xl font-bold mb-4">Loading Order Details...</h1>
                <p class="text-xl text-blue-100 max-w-2xl mx-auto">
                    Please wait while we retrieve your order information.
                </p>
            </div>
        </div>
    </section>
}
<!-- Error State -->
@if (hasError)
{
    <section class="bg-gradient-to-r from-red-500 to-red-600 text-white py-20">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <div class="bg-white w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-16 h-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </div>
                <h1 class="text-3xl md:text-4xl font-bold mb-4">Unable to Load Order</h1>
                <p class="text-xl text-red-100 max-w-2xl mx-auto mb-8">
                    We couldn't retrieve your order details. Please try again or contact support.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/"
                       class="bg-white text-red-600 hover:bg-red-50 font-bold py-3 px-8 rounded-lg transition-all duration-300 inline-block text-center">
                        Return to Home
                    </a>
                    <a href="/history"
                       class="border-2 border-white text-white hover:bg-white hover:text-red-600 font-bold py-3 px-8 rounded-lg transition-all duration-300 inline-block text-center">
                        View Order History
                    </a>
                </div>
            </div>
        </div>
    </section>
}
<!-- Success State -->
@if (!isLoading && !hasError)
{
    <section class="bg-gradient-to-r from-green-500 to-green-600 text-white py-20">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <div class="mb-8">
                    <div class="bg-white w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-16 h-16 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                </div>
                <h1 class="text-4xl md:text-5xl font-bold mb-6">Payment Successful!</h1>
                <p class="text-xl md:text-2xl text-green-100 max-w-3xl mx-auto mb-8">
                    Thank you for your order. Your payment has been processed successfully.
                </p>
                <div class="bg-white/20 backdrop-blur-sm rounded-lg p-6 max-w-md mx-auto">
                    <p class="text-lg mb-2">Order Number:</p>
                    <p class="text-2xl font-bold">#ORD-@orderId</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Order Details Section -->
    <section class="py-16">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                    <!-- Order Header -->
                    <div class="bg-gray-50 px-8 py-6 border-b">
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800 mb-2">Order Confirmation</h2>
                                <p class="text-gray-600">Order placed on @orderDate</p>
                            </div>
                            <div class="mt-4 md:mt-0">
                                <span class="bg-green-100 text-green-800 px-4 py-2 rounded-full font-semibold">
                                    Payment Successful
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="p-8">
                        <div class="gap-8">

                            <div>
                                <div class="bg-gray-50 rounded-lg p-6">
                                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Order Summary</h3>
                                    <div class="space-y-3">
                                        <div class="flex justify-between">
                                            <span class="text-gray-600">Subtotal</span>
                                            <span class="font-medium">@subtotal.ToString("C")</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-gray-600">Shipping</span>
                                            <span class="font-medium">@shipping.ToString("C")</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-gray-600">Tax</span>
                                            <span class="font-medium">@PriceHelper.FormatPrice(subtotal * 0.1m)</span>
                                        </div>
                                        @if (discount > 0)
                                        {
                                            <div class="flex justify-between text-green-600">
                                                <span>Discount</span>
                                                <span class="font-medium">-@PriceHelper.FormatPrice(discount))</span>
                                            </div>
                                        }
                                        <div class="border-t pt-3 mt-3">
                                            <div class="flex justify-between">
                                                <span class="text-lg font-semibold text-gray-800">Total</span>
                                                <span class="text-lg font-bold text-gray-800">@PriceHelper.FormatPrice(total)</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-6 pt-6 border-t">
                                        <h4 class="font-semibold text-gray-800 mb-2">Payment Method</h4>
                                        <div class="flex items-center space-x-2">
                                            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                                            </svg>
                                            <span class="text-gray-600">Credit Card ending in ****@lastFourDigits</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Shipping Information -->
                        <div class="mt-8 pt-8 border-t">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Shipping Information</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                <div>
                                    <h4 class="font-medium text-gray-700 mb-2">Shipping Address</h4>
                                    <div class="text-gray-600">
                                        <p>@shippingAddress.Name</p>
                                        <p>@shippingAddress.Street</p>
                                        <p>@shippingAddress.City, @shippingAddress.State @shippingAddress.ZipCode</p>
                                        <p>@shippingAddress.Country</p>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="font-medium text-gray-700 mb-2">Contact Information</h4>
                                    <div class="text-gray-600">
                                        <p>Email: @shippingAddress.Email</p>
                                        <p>Phone: @shippingAddress.Phone</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Estimated Delivery -->
                        <div class="mt-8 bg-blue-50 rounded-lg p-6">
                            <div class="flex items-start space-x-4">
                                <div class="bg-blue-100 w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0">
                                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
                                    </svg>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-gray-800 mb-2">Estimated Delivery</h4>
                                    <p class="text-gray-600 mb-2">
                                        Your order is expected to arrive between <strong>@estimatedDeliveryDate</strong>
                                    </p>
                                    <p class="text-sm text-gray-500">
                                        You will receive a shipping confirmation email once your order has been dispatched.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Next Steps Section -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">What's Next?</h2>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                    Here's what you can expect with your order
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
                <!-- Step 1 -->
                <div class="text-center">
                    <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Order Confirmation</h3>
                    <p class="text-gray-600">We've sent a confirmation email with your order details</p>
                </div>

                <!-- Step 2 -->
                <div class="text-center">
                    <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Order Processing</h3>
                    <p class="text-gray-600">We'll prepare your items for shipping within 1-2 business days</p>
                </div>

                <!-- Step 3 -->
                <div class="text-center">
                    <div class="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Delivery</h3>
                    <p class="text-gray-600">Your package will be delivered to your specified address</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Action Buttons -->
    <section class="py-12">
        <div class="container mx-auto px-4">
            <div class="text-center">
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/"
                       class="bg-blue-600 text-white hover:bg-blue-700 font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg inline-block text-center">
                        Continue Shopping
                    </a>
                    <a href="/history"
                       class="border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 inline-block text-center">
                        View Order History
                    </a>
                </div>

                <div class="mt-8">
                    <p class="text-gray-600 mb-4">Need help with your order?</p>
                    <a href="/contact"
                       class="text-blue-600 hover:text-blue-700 font-semibold underline">
                        Contact Customer Support
                    </a>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int orderId { get; set; }
    private string orderDate = DateTime.Now.ToString("MMMM dd, yyyy");
    private string estimatedDeliveryDate = DateTime.Now.AddDays(5).ToString("MMMM dd, yyyy");
    private string lastFourDigits = "1234";

    private decimal subtotal = 299.99m;
    private decimal shipping = 0.00m;
    private decimal tax = 0.00m;
    private decimal discount = 20.00m;
    private decimal total = 318.38m;

    private List<OrderItem> orderItems = new();
    private ShippingAddress shippingAddress = new();
    private bool isLoading = true;
    private bool hasError = false;
    private LoginResponse? _loginInfo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _loginInfo = await LocalStorage.GetLoginInfoAsync();
            StateHasChanged();
            if (_loginInfo == null)
            {
                Navigation.NavigateTo("/");
                return;
            }

            await LoadOrderData();
        }
    }


    private async Task LoadOrderData()
    {
        try
        {
            isLoading = true;
            hasError = false;

            // Get login info from local storage

            // Get order details from API - use GetAllAsync to filter by user
            var ordersResponse = await OrderService.GetAllAsync(customerId: _loginInfo.Customer.Id);

            if (ordersResponse?.Data != null)
            {
                Console.WriteLine($"OrderResponse Data: {System.Text.Json.JsonSerializer.Serialize(ordersResponse.Data)}");

                var order = ordersResponse.Data.FirstOrDefault(o => o.Id == orderId);

                // Update order details with real data
                if (order != null)
                {
                    Console.Write($"Order found: {order.Id} for user {_loginInfo.Customer.Id}");
                    orderDate = order.OrderDate.ToString("MMMM dd, yyyy");
                    discount = order.DiscountAmount;
                    @* tax = total * 0.1m; // Assuming 10% tax *@
                    subtotal = order.TotalAmount; // Calculate subtotal from total
                    total = subtotal - discount;

                    // Get order items for this specific order
                    var orderItemsResponse = await OrderService.GetOrderItemsAsync(orderId);
                    orderItems = orderItemsResponse.Data?.Select(item => new OrderItem
                    {
                        ProductName = $"Product {item.Productid}", // You may want to fetch product details
                        Quantity = item.Quantity,
                        Price = item.Price,
                    }).ToList() ?? new List<OrderItem>();
                }

                shippingAddress = new ShippingAddress
                {
                    Name = _loginInfo.Customer.Name, // Fetch from customer API
                    Street = _loginInfo.Customer.Address,
                    City = "Ho Chi Minh City",
                    State = "CS",
                    ZipCode = "12345",
                    Country = "Vietnam",
                    Email = _loginInfo.Customer.Email,
                    Phone = _loginInfo.Customer.Phone
                };
            }
            else
            {
                hasError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading order data: {ex.Message}");
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class OrderItem
    {
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; }
        public decimal Price { get; set; }
        public string ImageUrl { get; set; } = "";
    }

    public class ShippingAddress
    {
        public string Name { get; set; } = "";
        public string Street { get; set; } = "";
        public string City { get; set; } = "";
        public string State { get; set; } = "";
        public string ZipCode { get; set; } = "";
        public string Country { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
    }

}
