@page "/login"
@page "/auth/login"
@layout Layout.Main.MainLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using blazor_web.Services.Auth
@using blazor_web.Services.Storage
@using blazor_web.Components.UI
@inject blazor_web.Services.Auth.IAuthService AuthService
@inject blazor_web.Services.Storage.ILocalStorageService LocalStorageService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@rendermode InteractiveServer

<PageTitle>Login - ShopMart</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <!-- Header -->
        <div class="text-center">
            <div class="mx-auto h-16 w-16 bg-blue-600 rounded-full flex items-center justify-center">
                <svg class="h-10 w-10 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" />
                </svg>
            </div>
            <h2 class="mt-6 text-3xl font-extrabold text-gray-900">Sign in to your account</h2>
            <p class="mt-2 text-sm text-gray-600">
                Or
                <a href="/register" class="font-medium text-blue-600 hover:text-blue-500 transition-colors">
                    create a new account
                </a>
            </p>
        </div>

        <!-- Error Messages -->
        @if (!string.IsNullOrEmpty(ErrorMessage)) {
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-md">
                <div class="flex">
                    <svg class="h-5 w-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-sm">@ErrorMessage</span>
                </div>
            </div>
        }

        <!-- Success Messages -->
        @if (!string.IsNullOrEmpty(SuccessMessage)) {
            <div class="bg-green-50 border border-green-200 text-green-600 px-4 py-3 rounded-md">
                <div class="flex">
                    <svg class="h-5 w-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-sm">@SuccessMessage</span>
                </div>
            </div>
        }

        <!-- Loading State -->
        @if (isProcessing) {
            <LoadingSpinner Message="Signing in..." />
        }
        else {
        <!-- Login Form -->
        <EditForm Model="@loginModel" FormName="loginForm" OnValidSubmit="HandleLogin" class="mt-8 space-y-6 bg-white shadow-xl rounded-lg p-8">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <!-- Username Field -->
                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-1">
                        Username *
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <InputText id="username"
                                   @bind-Value="loginModel.Username"
                                   class="appearance-none relative block w-full pl-10 pr-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm transition-colors"
                                   placeholder="Enter your username" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Username)" class="text-red-500 text-xs mt-1" />
                </div>

                <!-- Password Field -->
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
                        Password *
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <InputText type="password"
                                   id="password"
                                   @bind-Value="loginModel.Password"
                                   class="appearance-none relative block w-full pl-10 pr-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm transition-colors"
                                   placeholder="Enter your password" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" class="text-red-500 text-xs mt-1" />
                </div>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <InputCheckbox id="remember-me"
                                   @bind-Value="loginModel.RememberMe"
                                   class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                    <label for="remember-me" class="ml-2 block text-sm text-gray-900">
                        Remember me
                    </label>
                </div>

                <div class="text-sm">
                    <a href="#" class="font-medium text-blue-600 hover:text-blue-500 transition-colors">
                        Forgot your password?
                    </a>
                </div>
            </div>

            <!-- Submit Button -->
            <div>
                <button type="submit"
                        class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-200 transform hover:scale-[1.02]">
                    <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                        <svg class="h-5 w-5 text-blue-500 group-hover:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                        </svg>
                    </span>
                    Sign in
                </button>
            </div>
        </EditForm>

        <!-- Back to Home -->
        <div class="text-center">
            <a href="/" class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 transition-colors">
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Back to Home
            </a>
        </div>
        }
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool isProcessing = false;

    protected override void OnInitialized() {
        // Check for error or success messages from query parameters
        var uri = new Uri(NavigationManager.Uri);
        var queryParameters = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (queryParameters["error"] != null) {
            ErrorMessage = queryParameters["error"];
        }

        if (queryParameters["success"] != null) {
            SuccessMessage = queryParameters["success"];
        }
    }

    public class LoginModel {
        [Required(ErrorMessage = "Username is required")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Username must be between 3 and 50 characters")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters long")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = false;
    }

    private async Task HandleLogin() {
        try {
            // Clear previous messages
            ErrorMessage = null;
            SuccessMessage = null;
            isProcessing = true;
            StateHasChanged();

            Console.WriteLine("=== HandleLogin called ===");
            Console.WriteLine($"All form values:");
            Console.WriteLine($"  Username: '{loginModel.Username}' (empty: {string.IsNullOrEmpty(loginModel.Username)})");
            Console.WriteLine($"  Password: '{loginModel.Password}' (empty: {string.IsNullOrEmpty(loginModel.Password)}, length: {loginModel.Password?.Length})");
            Console.WriteLine($"  RememberMe: {loginModel.RememberMe}");

            // Manual validation check since EditForm might not prevent submission
            var validationContext = new ValidationContext(loginModel);
            var validationResults = new List<ValidationResult>();
            var isValid = Validator.TryValidateObject(loginModel, validationContext, validationResults, true);

            if (!isValid) {
                // Show validation errors
                var errorMessages = validationResults.Select(vr => vr.ErrorMessage);
                ErrorMessage = string.Join("; ", errorMessages);
                Console.WriteLine($"Validation failed: {ErrorMessage}");
                isProcessing = false;
                StateHasChanged();
                return;
            }

            Console.WriteLine("Validation passed, creating request...");

            // Create a request DTO
            var loginRequest = new blazor_web.DTOs.Auth.LoginRequest {
                Username = loginModel.Username,
                Password = loginModel.Password
            };

            Console.WriteLine($"Login request created for user: {loginRequest.Username}");
            Console.WriteLine($"Password length: {loginRequest.Password.Length}");

            // Call the auth service
            Console.WriteLine("Calling AuthService.LoginAsync...");
            var result = await AuthService.LoginAsync(loginRequest);
            Console.WriteLine($"API call completed. Success: {result.Success}, Message: {result.Message}");

            if (result.Success && result.Data != null) {
                // Store login information in localStorage
                await LocalStorageService.SetLoginInfoAsync(result.Data);
                Console.WriteLine($"Login info stored for user: {result.Data}");

                // Notify authentication state provider
                if (AuthenticationStateProvider is CustomAuthenticationStateProvider customAuthStateProvider)
                {
                    await customAuthStateProvider.NotifyUserAuthentication(result.Data);
                }

                // Redirect based on user role
                var redirectTo = result.Data.User.Role.ToLowerInvariant() switch
                {
                    "admin" => "/admin",
                    "staff" => "/staff",
                    _ => "/"
                };
                NavigationManager.NavigateTo(redirectTo, forceLoad: true);
            } else {
                // Show error message without redirecting (preserves form data)
                ErrorMessage = !string.IsNullOrEmpty(result.Message)
                    ? result.Message
                    : "Login failed. Please try again.";
            }
        } catch (HttpRequestException ex) {
            ErrorMessage = $"Network error: {ex.Message}. Please check if API server is running.";
            Console.WriteLine($"HttpRequestException: {ex.Message}");
        } catch (Exception ex) {
            ErrorMessage = $"An unexpected error occurred: {ex.Message}";
            Console.WriteLine($"Exception: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        } finally {
            isProcessing = false;
            StateHasChanged();
        }

        // Refresh the component to show messages
        StateHasChanged();
    }
}
