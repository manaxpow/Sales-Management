@page "/register"
@layout Layout.Main.MainLayout
@using System.ComponentModel.DataAnnotations
@using blazor_web.Dtos.Auth
@inject blazor_web.Services.Auth.IAuthService AuthService
@inject NavigationManager NavigationManager
@using blazor_web.DTOs
@using blazor_web.DTOs.Auth

@rendermode InteractiveServer

<PageTitle>Register - ShopMart</PageTitle>

<div
    class="min-h-screen flex items-center justify-center bg-gradient-to-br from-green-50 to-blue-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full space-y-8">
        <!-- Error Messages -->
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-md">
                <div class="flex">
                    <svg class="h-5 w-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                            clip-rule="evenodd" />
                    </svg>
                    <span class="text-sm">@ErrorMessage</span>
                </div>
            </div>
        }

        <!-- Success Messages -->
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="bg-green-50 border border-green-200 text-green-600 px-4 py-3 rounded-md">
                <div class="flex">
                    <svg class="h-5 w-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                            clip-rule="evenodd" />
                    </svg>
                    <span class="text-sm">@SuccessMessage</span>
                </div>
            </div>
        }

        <!-- Header -->
        <div class="text-center">
            <div class="mx-auto h-16 w-16 bg-green-600 rounded-full flex items-center justify-center">
                <svg class="h-10 w-10 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path
                        d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z" />
                </svg>
            </div>
            <h2 class="mt-6 text-3xl font-extrabold text-gray-900">Create your account</h2>
            <p class="mt-2 text-sm text-gray-600">
                Or
                <a href="/login" class="font-medium text-green-600 hover:text-green-500 transition-colors">
                    sign in to your existing account
                </a>
            </p>
        </div>

        <!-- Registration Form -->
        <EditForm Model="@registerModel" FormName="registerForm" OnValidSubmit="HandleRegister"
            class="mt-8 space-y-6 bg-white shadow-xl rounded-lg p-8">
            <DataAnnotationsValidator />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Username Field -->
                <div class="md:col-span-2">
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-1">
                        Username *
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                                    clip-rule="evenodd" />
                            </svg>
                        </div>
                        <InputText id="username" @bind-Value="registerModel.Username"
                            class="appearance-none relative block w-full pl-10 pr-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 focus:z-10 sm:text-sm transition-colors"
                            placeholder="Choose a username" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Username)" class="text-red-500 text-xs mt-1" />
                </div>

                <!-- Full Name Field -->
                <div class="md:col-span-2">
                    <label for="fullName" class="block text-sm font-medium text-gray-700 mb-1">
                        Full Name *
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                                    clip-rule="evenodd" />
                            </svg>
                        </div>
                        <InputText id="fullName" @bind-Value="registerModel.FullName"
                            class="appearance-none relative block w-full pl-10 pr-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 focus:z-10 sm:text-sm transition-colors"
                            placeholder="Enter your full name" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.FullName)" class="text-red-500 text-xs mt-1" />
                </div>

                <!-- Email Field -->
                <div class="md:col-span-2">
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                        Email Address *
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                            </svg>
                        </div>
                        <InputText id="email" @bind-Value="registerModel.Email"
                            class="appearance-none relative block w-full pl-10 pr-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 focus:z-10 sm:text-sm transition-colors"
                            placeholder="Enter your email" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Email)" class="text-red-500 text-xs mt-1" />
                </div>

                <!-- Phone Field -->
                <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
                        Phone Number
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                            </svg>
                        </div>
                        <InputText id="phone" @bind-Value="registerModel.Phone"
                            class="appearance-none relative block w-full pl-10 pr-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 focus:z-10 sm:text-sm transition-colors"
                            placeholder="Enter phone number" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Phone)" class="text-red-500 text-xs mt-1" />
                </div>

                <!-- Password Field -->
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
                        Password *
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                    d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                                    clip-rule="evenodd" />
                            </svg>
                        </div>
                        <InputText type="password" id="password" @bind-Value="registerModel.Password"
                            class="appearance-none relative block w-full pl-10 pr-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 focus:z-10 sm:text-sm transition-colors"
                            placeholder="Create a password" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Password)" class="text-red-500 text-xs mt-1" />
                </div>

                <!-- Address Field -->
                <div class="md:col-span-2">
                    <label for="address" class="block text-sm font-medium text-gray-700 mb-1">
                        Address
                    </label>
                    <div class="relative">
                        <div class="absolute top-3 left-0 pl-3 flex items-start pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                    d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                                    clip-rule="evenodd" />
                            </svg>
                        </div>
                        <InputTextArea id="address" @bind-Value="registerModel.Address" rows="3"
                            class="appearance-none relative block w-full pl-10 pr-3 py-3 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 focus:z-10 sm:text-sm transition-colors"
                            placeholder="Enter your address" />
                    </div>
                    <ValidationMessage For="@(() => registerModel.Address)" class="text-red-500 text-xs mt-1" />
                </div>

                <!-- Terms and Conditions -->
                <div class="md:col-span-2">
                    <div class="flex items-center">
                        <InputCheckbox id="terms" @bind-Value="registerModel.AcceptTerms"
                            class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded" />
                        <label for="terms" class="ml-2 block text-sm text-gray-900">
                            I agree to the
                            <a href="#" class="text-green-600 hover:text-green-500 font-medium">Terms and Conditions</a>
                            and
                            <a href="#" class="text-green-600 hover:text-green-500 font-medium">Privacy Policy</a>
                        </label>
                    </div>
                    <ValidationMessage For="@(() => registerModel.AcceptTerms)" class="text-red-500 text-xs" />
                </div>
            </div>

            <!-- Submit Button -->
            <div>
                <button type="submit"
                    class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all duration-200 transform hover:scale-[1.02]">
                    <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                        <svg class="h-5 w-5 text-green-500 group-hover:text-green-400" fill="currentColor"
                            viewBox="0 0 20 20">
                            <path
                                d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z" />
                        </svg>
                    </span>
                    Create Account
                </button>
            </div>
        </EditForm>

        <!-- Back to Home -->
        <div class="text-center">
            <a href="/" class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 transition-colors">
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                        d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                        clip-rule="evenodd" />
                </svg>
                Back to Home
            </a>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    protected override void OnInitialized()
    {
        // Check for error or success messages from query parameters
        var uri = new Uri(NavigationManager.Uri);
        var queryParameters = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (queryParameters["error"] != null)
        {
            ErrorMessage = queryParameters["error"];
        }

        if (queryParameters["success"] != null)
        {
            SuccessMessage = queryParameters["success"];
        }
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Username is required")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Username must be between 3 and 50 characters")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Full name is required")]
        [StringLength(100, ErrorMessage = "Full name cannot exceed 100 characters")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Phone number is required")]
        [Phone(ErrorMessage = "Please enter a valid phone number")]
        public string? Phone { get; set; }

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters long")]
        public string Password { get; set; } = "";

        public string? Address { get; set; } = "";

        [Required(ErrorMessage = "You must accept the terms and conditions")]
        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the terms and conditions")]
        public bool AcceptTerms { get; set; } = false;
    }

    private async Task HandleRegister()
    {
        try
        {
            // Clear previous messages
            ErrorMessage = null;
            SuccessMessage = null;

            Console.WriteLine("=== HandleRegister called ===");

            Console.WriteLine($"AcceptTerms value: {registerModel.AcceptTerms}");
            Console.WriteLine($"All form values:");
            Console.WriteLine($" Username: '{registerModel.Username}' (empty: {string.IsNullOrEmpty(registerModel.Username)})");
            Console.WriteLine($" FullName: '{registerModel.FullName}' (empty: {string.IsNullOrEmpty(registerModel.FullName)})");
            Console.WriteLine($" Email: '{registerModel.Email}' (empty: {string.IsNullOrEmpty(registerModel.Email)})");
            Console.WriteLine($" Password: '{registerModel.Password}' (empty: {string.IsNullOrEmpty(registerModel.Password)}, length: {registerModel.Password?.Length})");
            Console.WriteLine($" Phone: '{registerModel.Phone}'");
            Console.WriteLine($" Address: '{registerModel.Address}'");
            Console.WriteLine($" AcceptTerms: {registerModel.AcceptTerms}");

            // Manual validation check since EditForm might not prevent submission
            var validationContext = new ValidationContext(registerModel);
            var validationResults = new List<ValidationResult>();
            var isValid = Validator.TryValidateObject(registerModel, validationContext, validationResults, true);

            if (!isValid)
            {
                // Show validation errors
                var errorMessages = validationResults.Select(vr => vr.ErrorMessage);
                ErrorMessage = string.Join("; ", errorMessages);
                Console.WriteLine($"Validation failed: {ErrorMessage}");
                return;
            }

            Console.WriteLine("Validation passed, creating request...");

            // Create the request DTO
            var registerRequest = new RegisterRequest
            {
                Username = registerModel.Username,
                FullName = registerModel.FullName,
                Email = registerModel.Email,
                Phone = registerModel.Phone ?? "",
                Password = registerModel.Password,
                Address = registerModel.Address ?? ""
            };

            Console.WriteLine($"Register request created for user: {registerRequest.Username}");
            Console.WriteLine($"Email: {registerRequest.Email}");
            Console.WriteLine($"Phone: {registerRequest.Phone}");
            Console.WriteLine($"Password length: {registerRequest.Password.Length}");

            // Call the auth service
            Console.WriteLine("Calling AuthService.RegisterAsync...");
            var result = await AuthService.RegisterAsync(registerRequest);
            Console.WriteLine($"API call completed. Success: {result.Success}, Message: {result.Message}");

            if (result.Success)
            {
                // Redirect with success message
                var returnUrl = $"/register?success={Uri.EscapeDataString("Account created successfully! You can now sign in.")}";
                NavigationManager.NavigateTo(returnUrl, forceLoad: true);
            }
            else
            {
                // Show error message without redirecting (preserves form data)
                ErrorMessage = !string.IsNullOrEmpty(result.Message)
                ? result.Message
                : "Registration failed. Please try again.";
            }
        }
        catch (HttpRequestException ex)
        {
            ErrorMessage = $"Network error: {ex.Message}. Please check if API server is running.";
            Console.WriteLine($"HttpRequestException: {ex.Message}");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An unexpected error occurred: {ex.Message}";
            Console.WriteLine($"Exception: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }

        // Refresh the component to show messages
        StateHasChanged();
    }
}