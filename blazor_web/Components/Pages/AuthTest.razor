@page "/auth-test"
@using Microsoft.AspNetCore.Components.Authorization
@using blazor_web.Services.Auth
@using blazor_web.Services.Storage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILocalStorageService LocalStorageService

<PageTitle>Authentication Test</PageTitle>

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white shadow rounded-lg">
            <div class="px-4 py-5 sm:p-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-6">
                    Authentication Status Test
                </h3>

                <AuthorizeView Context="authContext">
                    <Authorized>
                        <div class="space-y-6">
                            <div class="bg-green-50 border border-green-200 rounded-md p-4">
                                <h4 class="text-green-800 font-medium">✅ User is Authenticated</h4>
                            </div>

                            <div class="bg-blue-50 border border-blue-200 rounded-md p-4">
                                <h4 class="text-blue-800 font-medium mb-3">User Information:</h4>
                                <div class="space-y-2 text-sm">
                                    <div><strong>Name:</strong> @authContext.User.Identity?.Name</div>
                                    <div><strong>Is Authenticated:</strong> @authContext.User.Identity?.IsAuthenticated</div>
                                    <div><strong>Authentication Type:</strong> @authContext.User.Identity?.AuthenticationType</div>
                                    <div><strong>Full Name:</strong> @authContext.User.FindFirst("FullName")?.Value</div>
                                    <div><strong>User ID:</strong> @authContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value</div>
                                    <div><strong>Role:</strong> @authContext.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                                    <div><strong>Access Token:</strong> @(string.IsNullOrEmpty(authContext.User.FindFirst("AccessToken")?.Value) ? "Not Available" : "Available")</div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <AuthorizeView Roles="admin" Context="adminContext">
                                    <div class="bg-purple-50 border border-purple-200 rounded-md p-4">
                                        <h4 class="text-purple-800 font-medium">Admin Access: ✅</h4>
                                        <p class="text-purple-600 text-sm mt-1">User has admin privileges</p>
                                    </div>
                                </AuthorizeView>

                                <AuthorizeView Roles="staff" Context="staffContext">
                                    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
                                        <h4 class="text-yellow-800 font-medium">Staff Access: ✅</h4>
                                        <p class="text-yellow-600 text-sm mt-1">User has staff privileges</p>
                                    </div>
                                </AuthorizeView>
                            </div>

                            <div class="flex space-x-4">
                                <a href="/admin" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                                    Go to Admin Dashboard
                                </a>
                                <a href="/staff" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                    Go to Staff Dashboard
                                </a>
                                <a href="/logout" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700">
                                    Logout
                                </a>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="space-y-6">
                            <div class="bg-red-50 border border-red-200 rounded-md p-4">
                                <h4 class="text-red-800 font-medium">❌ User is Not Authenticated</h4>
                            </div>

                            <div class="bg-gray-50 border border-gray-200 rounded-md p-4">
                                <h4 class="text-gray-800 font-medium mb-3">Available Actions:</h4>
                                <div class="space-y-3">
                                    <a href="/auth/login" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
                                        Login
                                    </a>
                                    <a href="/register" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 ml-3">
                                        Register
                                    </a>
                                </div>
                            </div>

                            <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
                                <h4 class="text-yellow-800 font-medium mb-2">Test Protected Routes:</h4>
                                <p class="text-yellow-600 text-sm mb-3">These routes should redirect you to login:</p>
                                <div class="space-y-2">
                                    <a href="/admin" class="text-blue-600 hover:text-blue-500 text-sm">/admin (Admin only)</a><br>
                                    <a href="/staff" class="text-blue-600 hover:text-blue-500 text-sm">/staff (Staff & Admin)</a>
                                </div>
                            </div>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Test authentication state provider
        if (AuthenticationStateProvider is CustomAuthenticationStateProvider customAuthProvider)
        {
            var isAuth = await customAuthProvider.IsUserAuthenticatedAsync();
            var role = await customAuthProvider.GetUserRoleAsync();
            var loginInfo = await LocalStorageService.GetLoginInfoAsync();
            
            Console.WriteLine("=== Auth Test ===");
            Console.WriteLine($"Is Authenticated: {isAuth}");
            Console.WriteLine($"User Role: {role}");
            Console.WriteLine($"Login Info Available: {loginInfo != null}");
        }
    }
}
