@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase

<div class="fixed inset-0 bg-gray-500 bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 shadow-xl">
        <div class="flex items-center space-x-4">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
            <div class="text-gray-700 font-medium">Verifying authentication...</div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Message { get; set; } = "Verifying authentication...";
}
