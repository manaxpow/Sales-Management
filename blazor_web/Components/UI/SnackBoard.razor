@code {
    private bool open;
    private string message = "";
    private string type = "success";
    private string position = "bottom-right";
    private string animationClass = "";

    public async void Show(string message, string type = "success", string position = "bottom-right")
    {
        this.message = message;
        this.type = type;
        this.position = position;

        animationClass = "snackbar-enter";
        open = true;
        StateHasChanged();

        await Task.Delay(300);
        animationClass = "";

        await Task.Delay(3000);
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        animationClass = "snackbar-leave";
        StateHasChanged();

        await Task.Delay(300);

        open = false;
        animationClass = "";
        StateHasChanged();
    }

    private async void Close()
    {
        await CloseAsync();
    }

    private string GetPositionClass() =>
        position switch
        {
            "top-left" => "snackbar-top-left",
            "top-right" => "snackbar-top-right",
            "bottom-left" => "snackbar-bottom-left",
            _ => "snackbar-bottom-right"
        };

    private MarkupString GetIcon()
    {
        string svg = type switch
        {
            "success" => @"<svg width=""20"" height=""20"" fill=""currentColor"" class=""me-2 text-success"" viewBox=""0 0 20 20"">
                               <path d=""M10 0a10 10 0 1 0 0 20A10 10 0 0 0 10 0Zm-1 15L4 10l1.4-1.4 3.6 3.6 6-6L16.4 7l-7.4 8Z""/>
                           </svg>",

            "danger" => @"<svg width=""20"" height=""20"" fill=""currentColor"" class=""me-2 text-danger"" viewBox=""0 0 20 20"">
                              <path d=""M10 0a10 10 0 1 0 0 20A10 10 0 0 0 10 0Zm3.5 13.5-1.4 1.4L10 11.4l-2.1 2.1-1.4-1.4 2.1-2.1-2.1-2.1L7.9 6l2.1 2.1L12.1 6l1.4 1.4-2.1 2.1 2.1 2.1Z""/>
                          </svg>",

            "warning" => @"<svg width=""20"" height=""20"" fill=""currentColor"" class=""me-2 text-warning"" viewBox=""0 0 20 20"">
                               <path d=""M10 0 0 18h20L10 0Zm1 14H9v-2h2v2Zm0-4H9V7h2v3Z""/>
                           </svg>",

            _ => @"<svg width=""20"" height=""20"" fill=""currentColor"" class=""me-2 text-info"" viewBox=""0 0 20 20"">
                      <path d=""M10 0a10 10 0 1 0 0 20A10 10 0 0 0 10 0Zm1 15H9V9h1v6Zm0-8H9V5h2v2Z""/>
                  </svg>"
        };

        return (MarkupString)svg;
    }
}

@if (open)
{
    <div class="@GetPositionClass() @animationClass">
        <div class="alert alert-@type alert-dismissible shadow-lg d-flex align-items-center fade show">
            @GetIcon()
            <span>@message</span>
            <button type="button" class="btn-close ms-3" @onclick="Close"></button>
        </div>
    </div>
}
