@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<AuthorizeView Context="authContext">
    <Authorized>
        <header class="bg-white shadow-sm border-b border-gray-200">
            <div class="px-6">
                <div class="flex items-center justify-between">
                    <!-- Left side - Page Title -->
                    <div class="flex items-center">                
                        <!-- Page Title -->
                        <div class="ml-4">
                            <h1 class="text-xl font-semibold text-gray-900">Staff Dashboard</h1>
                            <p class="text-sm text-gray-500">Welcome back, @authContext.User.FindFirst("FullName")?.Value ?? authContext.User.Identity?.Name</p>
                        </div>
                    </div>

                    <!-- Right side - User Menu -->
                    <div class="flex items-center space-x-4">
                        <!-- User Menu -->
                        <div class="relative" x-data="{ userMenuOpen: false }">
                            <button @onclick="ToggleUserMenu" class="flex items-center space-x-3 text-sm rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                <div class="w-10 h-10 rounded-full bg-indigo-100 border-2 border-indigo-200 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-indigo-700" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3a7 7 0 007 7v1a1 1 0 001 1h4a1 1 0 001-1v-4a1 1 0 001-1H3z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                                <span class="hidden md:block text-gray-700 font-medium">
                                    @(authContext.User.FindFirst("FullName")?.Value ?? authContext.User.Identity?.Name)
                                </span>
                                <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            </button>

                            <!-- Dropdown menu -->
                            @if (userMenuOpen)
                            {
                                <div class="origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 divide-y divide-gray-100 focus:outline-none z-50">
                                    <div class="py-1">
                                        <div class="px-4 py-2 text-sm text-gray-700">
                                            <div class="font-medium">@(authContext.User.FindFirst("FullName")?.Value ?? "Staff User")</div>
                                            <div class="text-gray-500">@(authContext.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")</div>
                                        </div>
                                    </div>
                                    <div class="py-1">
                                        <a href="/staff/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Profile</a>
                                        <a href="/staff/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings</a>
                                    </div>
                                    <div class="py-1">
                                        <button @onclick="Logout" class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100">
                                            Sign out
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </header>
    </Authorized>
</AuthorizeView>

@code {
    private bool userMenuOpen = false;

    private void ToggleUserMenu()
    {
        userMenuOpen = !userMenuOpen;
    }

    private async Task Logout()
    {
        // Navigate to logout page which will handle the logout process
        NavigationManager.NavigateTo("/logout");
    }

    // Close dropdown when clicking outside
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender && userMenuOpen)
        {
            // Add a small delay to allow the dropdown to render before attaching the click handler
            Task.Run(async () =>
            {
                await Task.Delay(100);
                // In a real implementation, you might want to use JS interop to handle clicks outside
            });
        }
    }
}
