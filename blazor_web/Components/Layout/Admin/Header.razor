<header class="bg-white shadow-sm border-b border-gray-200" x-data="{ userMenuOpen: false }">
    <div class="px-6">
        <div class="flex items-center justify-between">
            <!-- Left side - Mobile menu toggle and Page Title -->
            <div class="flex items-center">                
                <!-- Page Title -->
                <div class="ml-4">
                    <h1 class="text-xl font-semibold text-gray-900">Tổng quan</h1>
                    <p class="text-sm text-gray-500">Chào mừng trở lại</p>
                </div>
            </div>

            <!-- Right side - Search, Notifications, User Menu -->
            <div class="flex items-center space-x-4">
                <!-- User Menu -->
                <div class="relative">
                    <img src="https://picsum.photos/seed/admin/40/40.jpg" alt="User Avatar" class="w-10 h-10 rounded-full border-2 border-gray-200">
                </div>
            </div>
        </div>
    </div>
</header>
